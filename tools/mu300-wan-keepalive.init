#!/bin/sh /etc/rc.common
# TEMPORARY diagnostic service (2026-10-13): keeps the WAN from ever going idle, to test whether
# the ~10-min SIPA wedge is triggered by the modem's idle/sleep path.
#
# This file is installed BY HAND (it is deliberately not part of rootfs/overlay -- the normal
# install must not carry it). Install / remove:
#   ssh root@192.168.77.1 'cat > /etc/init.d/mu300-wan-keepalive && chmod 755 /etc/init.d/mu300-wan-keepalive' \
#       < mu300-linux/tools/mu300-wan-keepalive.init
#   ssh root@192.168.77.1 '/etc/init.d/mu300-wan-keepalive enable && /etc/init.d/mu300-wan-keepalive start'
#   ssh root@192.168.77.1 '/etc/init.d/mu300-wan-keepalive disable && rm /etc/init.d/mu300-wan-keepalive'
#
# Requires /root/wan-keepalive.sh (tools/mu300-wan-keepalive.sh). NOTE: procd sends an instance's
# stdout to syslog, so with stdout 1 below the samples land in `logread`, NOT in the LOG argument --
# the file only gets written when the script is started by hand with a shell redirection.
#
# Context, and why the experiment is still open: docs/mu300/sipa-wedge.md §6.4.1
START=99
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /root/wan-keepalive.sh /root/wan-keepalive.log
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
