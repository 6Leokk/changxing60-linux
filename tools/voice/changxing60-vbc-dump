#!/bin/sh
# Dump the VBC (voice band codec) profiles the kernel currently holds, one file per profile.
#
# WHY THIS EXISTS. Call audio on this board runs through the SC2730/UMP9620 VBC block, and the VBC
# wants four firmware profiles (audio_structure, dsp_vbc, cvs, dsp_smartamp) before it can process a
# voice path. Those blobs are not on this device's OpenWrt rootfs, are not in the vendor image we
# have, and are not in any partition dump we hold -- so there is nothing to copy them from. They are,
# however, loaded in RAM by Android's own audio HAL on every Android boot. The kernel exposes what it
# holds: /dev/vbc_turningN has a .read, and it returns the same hdr[]/data[] arrays that a write (or
# request_firmware) fills. So the way to get the blobs is to let Android load them and then read them
# back out. This script is that read. Run it on Android with CHANGXING60_VBC_ALLOW_UNLOADED=1 (see
# below); on OpenWrt it only reads once the loader's per-boot marker exists.
#
# THE ABI, from the driver (kernel_modules/kernel5.4/audio_driver/sprd/dai/vbc/v4/vbc_dai/vbc-dai.c):
#
#   node          profile id   name             fops
#   turning0      0            audio_structure  vbc_turning_structure_{read,write}
#   turning1      1            dsp_vbc          vbc_turning_DSP_{read,write}
#   turning2      2            cvs              vbc_turning_NXP_{read,write}
#   turning3      3            dsp_smartamp     vbc_turning_SMARTPA_{read,write}
#
#   payload = struct vbc_fw_header { char magic[16]; u32 num_mode; u32 len_mode; }  (24 bytes)
#             followed by num_mode * len_mode bytes
#   magic   = "audio_profile" (VBC_PROFILE_FIRMWARE_MAGIC_LEN 16)
#
# TWO TRAPS, both hit while working this out:
#
#   1. ONE READ, NOT MANY. vbc_turning_profile_get() has two branches on the requested size: if it is
#      <= 24 it copies just the header and says so ("only get profile %s party header!"); only above
#      24 does it go on to the data. And vbc_turning_ndp_read() copy_to_user()s the FULL requested
#      size, not the returned count. So the read has to be one big read -- `dd bs=1 count=64` is 64
#      separate 1-byte reads, every one of them landing in the header-only branch, and the result is
#      64 bytes of the header's leading zeros, which looks exactly like "the profile is all zeros".
#   2. THE DRIVER'S SIZE AND THE BUFFER'S SIZE ARE TWO DIFFERENT NUMBERS. copy_to_user() copies the
#      FULL requested size, so the userspace buffer has zeros past num_mode*len_mode; but read()
#      returns only 24 + num_mode*len_mode, and dd writes what read() returned, so the file is already
#      the right length. The header is therefore not needed to trim -- it is needed to CHECK, and this
#      script fails the profile if the two disagree.
#
# WHEN NOTHING IS LOADED, PROFILE 0 IS A KERNEL CRASH, NOT AN ENOMEM. This header used to say that an
# unloaded profile answers -ENOMEM ("profile %s data is NULL!") and that this is the normal OpenWrt
# answer. It is true for profiles 1-3 -- their reads check data[id] first. It is FALSE for profile 0:
# vbc_turning_structure_read() dereferences the NULL pointer with no check (fault address 0x18), and
# with panic_on_oops=1 on this board a plain `dd if=/dev/vbc_turning0 bs=262144` oopsed the kernel and
# rebooted it -- measured 2026-10-17 when the boot service snapshotted before loading anything
# (docs/changxing60/audio-oops.md, pstore in rescue/dumps/2026-10-17-guard-boot-panic/). So reading
# turning0 is gated: it happens only when /tmp/changxing60-vbc-loaded exists -- touched by
# changxing60-vbc-load right after a successful audio_structure write, and cleared by every boot --
# or when CHANGXING60_VBC_ALLOW_UNLOADED=1 says you know the kernel holds it (an Android boot, where
# you cannot create that marker). Without either, turning0 is reported as refused and not read.
#
#   changxing60-vbc-dump [OUTDIR]     default OUTDIR /tmp/vbc-profiles
#
# Writes OUTDIR/<name>.bin (the exact bytes to write back to the same node) and OUTDIR/README, and
# prints one line per profile. Exit 0 if at least one profile came out, 1 if none did.
set -u

OUT=${1:-/tmp/vbc-profiles}
MARKER=${CHANGXING60_VBC_LOADED:-/tmp/changxing60-vbc-loaded}
ALLOW_UNLOADED=${CHANGXING60_VBC_ALLOW_UNLOADED:-0}
# Override for host tests only; on the device this is /dev/vbc_turning, the real nodes.
DEVS=${CHANGXING60_VBC_DEV_PREFIX:-/dev/vbc_turning}
# 256 KiB is one read. The largest profile on this family is tens of KiB; a bigger buffer than the
# profile costs nothing but zeros, and a smaller one silently truncates the payload (the driver
# copies min(requested, payload) and reports the short read as success).
MAX=262144

mkdir -p "$OUT" 2>/dev/null || { echo "changxing60-vbc-dump: cannot create $OUT" >&2; exit 1; }

# A little-endian u32 at byte offset $2 of file $1.
#
# hexdump and not od, and that is not a preference: this rootfs's busybox has no od at all, and a
# missing od in a command substitution is a SILENT empty string, not an error -- the first version of
# this script used `od -An -tu4 -j 16 -N 4` and reported "cannot read num_mode" on a profile that had
# read back perfectly. hexdump is in busybox and in toybox (Android), so it is the one that is there
# on both sides of this procedure. `1/4 "%u\n"` is one 4-byte unit per line, unsigned decimal.
u32() {
    if command -v hexdump >/dev/null 2>&1; then
        hexdump -s "$2" -n 4 -e '1/4 "%u\n"' "$1" 2>/dev/null | head -1
    else
        # Only reached on a host that has no hexdump (this rootfs always does, and the od that
        # hosts have does not exist here). Same little-endian u32, for tools/voice/test-vbc-load.sh.
        od -An -tu4 -j "$2" -N 4 "$1" 2>/dev/null | tr -d ' ' | head -1
    fi
}

got=0
i=0
for name in audio_structure dsp_vbc cvs dsp_smartamp; do
    dev=$DEVS$i
    raw=$OUT/$name.raw
    bin=$OUT/$name.bin
    node=$i
    i=$((i + 1))

    if [ ! -e "$dev" ]; then
        echo "$name: $dev does not exist"
        continue
    fi

    # turning0's FULL read is the one read an unloaded kernel cannot survive: reads over 24 bytes
    # go to the data branch, and vbc_turning_structure_read() dereferences the NULL there (small
    # reads stay in the header branch and are safe -- voice-audio's 24-byte probe relies on that).
    # The dd below asks for $MAX, so it is the unsafe shape. Refuse before it unless the loader's
    # marker or an explicit override says the structure is in memory.
    if [ "$node" = 0 ] && [ ! -f "$MARKER" ] && [ "$ALLOW_UNLOADED" != 1 ]; then
        echo "$name: refused -- $MARKER absent, nothing has loaded audio_structure this boot"
        echo "$name:   a full-size read of $dev would be a kernel oops; set"
        echo "$name:   CHANGXING60_VBC_ALLOW_UNLOADED=1 only on a boot where you know the"
        echo "$name:   profile is loaded (an Android boot, where the marker cannot exist)"
        continue
    fi

    rm -f "$raw" "$bin"
    # stderr is kept: when nothing is loaded the driver's ENOMEM arrives here as "Out of memory", and
    # that is the difference between "empty node" and "read failed".
    err=$(dd if="$dev" of="$raw" bs=$MAX count=1 2>&1 >/dev/null)
    if [ ! -s "$raw" ]; then
        echo "$name: nothing loaded ($err)"
        rm -f "$raw"
        continue
    fi

    magic=$(dd if="$raw" bs=16 count=1 2>/dev/null | tr -d '\000')
    if [ "$magic" != "audio_profile" ]; then
        echo "$name: read $MAX bytes but the header magic is not \"audio_profile\" -- not a profile"
        rm -f "$raw"
        continue
    fi

    num=$(u32 "$raw" 16)
    len=$(u32 "$raw" 20)
    case $num in ''|*[!0-9]*) echo "$name: cannot read num_mode"; rm -f "$raw"; continue ;; esac
    case $len in ''|*[!0-9]*) echo "$name: cannot read len_mode"; rm -f "$raw"; continue ;; esac

    want=$((24 + num * len))
    # dd has already written exactly as many bytes as the driver's read() returned, which is
    # 24 + num_mode*len_mode -- measured on this board with a synthetic 424-byte profile: dd reported
    # "0+1 records out" and the file was 424 bytes, md5-identical to what was written in. So this is
    # not a trim, it is a CROSS-CHECK: the header we just parsed must agree with the length the
    # driver itself accounted for. If they disagree, one of the two is wrong and the blob is not
    # trustworthy, so it is dropped rather than kept with a warning.
    have=$(wc -c < "$raw" 2>/dev/null)
    if [ "$have" != "$want" ]; then
        echo "$name: header says $want bytes, the driver returned $have -- refusing to keep it"
        rm -f "$raw"
        continue
    fi
    mv "$raw" "$bin"

    echo "$name: $want bytes (num_mode=$num len_mode=$len) -> $bin"
    got=$((got + 1))
done

cat > "$OUT/README" <<'EOF'
VBC profiles read back from /dev/vbc_turning0..3.

Each <name>.bin is the exact byte string to write back to the same node:

    dd if=<name>.bin of=/dev/vbc_turning<N> bs=<file size, at least> count=1

with N = 0 audio_structure, 1 dsp_vbc, 2 cvs, 3 dsp_smartamp. bs must be at least the file size:
the driver treats ONE write() as ONE complete profile and checks the "audio_profile" magic at the
front of every write, so a blob split across writes by a smaller bs has its tail rejected -EINVAL.
bs=65536 looked fine for the two smaller profiles and only failed on dsp_vbc, which is exactly the
shape of bug that gets mistaken for a bad blob (measured 2026-10-16).

Layout: 16-byte magic "audio_profile", u32 num_mode, u32 len_mode, then num_mode*len_mode bytes.

These are board firmware, taken from this handset's own Android boot. Whether they may be
redistributed is a separate question from whether they work -- keep them out of the repo.
EOF

if [ "$got" -gt 0 ]; then
    echo "changxing60-vbc-dump: $got profile(s) in $OUT"
    exit 0
fi
echo "changxing60-vbc-dump: nothing readable -- no profile loaded, turning0 refused, or (rare) the loaded ones all failed the header cross-check" >&2
echo "  on OpenWrt: run changxing60-vbc-load first (it sets $MARKER)" >&2
echo "  on Android: CHANGXING60_VBC_ALLOW_UNLOADED=1 $0 (only if the audio HAL has actually loaded)" >&2
exit 1
