+/*
+ * The device tree describes the whole display subsystem, including output paths this kernel is
+ * not built with. component_master_add_with_match() waits for every component it matches, and a
+ * component whose driver is not compiled in can never be added -- so matching one hangs the
+ * master forever and the panel never comes up, with nothing in the log to explain it.
+ *
+ * On this board dpu1@31880000 is status=okay although the display module is built with
+ * CONFIG_DRM_SPRD_DPU0 + CONFIG_DRM_SPRD_DSI only (changxing60-linux/kernel/build-internal-display.sh),
+ * and it is reachable both as a display-subsystem port parent and, on other boards, through the
+ * DP transmitter that the dpu1 port points at. Drop both here the same way the driver
+ * registration table below is #ifdef d out, so the match reflects what this build provides.
+ */
+static bool sprd_drm_component_built(struct device_node *np)
+{
+#if !IS_ENABLED(CONFIG_DRM_SPRD_DPU1)
+	if (of_device_is_compatible(np, "sprd,qogirn6pro-dpu1"))
+		return false;
+#endif
+#if !IS_ENABLED(CONFIG_DRM_SPRD_DP)
+	if (of_device_is_compatible(np, "sprd,dptx"))
+		return false;
+#endif
+	return true;
+}
