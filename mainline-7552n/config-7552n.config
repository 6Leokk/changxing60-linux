# 7552N (ZTE 7552N / 畅行60) deltas on top of upstream's mu300-mainline.config.
#
# Merge order in build.sh: allnoconfig -> mu300-mainline.config -> this file -> olddefconfig.
# Keep this list short and justified: everything here is a *board* difference from upstream's F50/MU300/U30 Air
# (which boot from eMMC), not a preference.

# --- UFS: the 7552N's boot device ---------------------------------------------------------------
# Upstream's board is eMMC, so their config has MMC_SDHCI_SPRD=y and all of UFS off
# (`# CONFIG_SCSI_UFSHCD is not set`) even though 6.18 carries drivers/ufs/host/ufs-sprd.c.
# Without these three there is no /dev/sda at all: no partition table, no ext4 rootfs, no USB gadget
# userspace -- which is exactly how the first trial boot (2026-10-14) failed.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_SPRD=y
# NOT set: CONFIG_SCSI_UFS_CRYPTO.  It depends on BLK_INLINE_ENCRYPTION (fscrypt / Android FBE) and our
# rootfs is a plain ext4 with no fscrypt.  Nothing is lost: ufs-sprd.c has no #ifdef around the crypto
# path -- it advertises UFSHCD_CAP_CRYPTO and clears it at runtime when the SIP call fails
# ("key reg access enable fail, disable crypto"), so the driver builds and probes identically either way.

# --- kept for the record, already =y in mu300-mainline.config ------------------------------------
# CONFIG_SPRD_UMS9620_CLK=y          the clk+reset provider ufs-sprd's resets hang off
# CONFIG_SPRD_UMS9620_IPA_PD=y       port/drivers/pmdomain/sprd/ums9620-ipa-sys.c
# CONFIG_USB_SPRD_UMS9620_SSPHY=y    port/drivers/usb/phy/phy-sprd-ums9620-ssphy.c
# CONFIG_REGULATOR_UMP9620=y         vdd-mphy-supply / vcc-supply
# CONFIG_MFD_SYSCON=y                syscon_regmap_lookup_by_phandle()
