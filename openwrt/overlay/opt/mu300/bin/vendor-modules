#!/bin/sh
# Vendor drivers Android loads that the boot module set does not carry, staged from the 5.4 build
# tree (out-linux) so their vermagic matches the kernel that actually runs here.
#
# Why not /etc/module-order: that list lives in the initramfs, so a module that wedges its probe
# there is fatal to the boot. Everything below only registers a device node -- nothing the network
# needs depends on it -- so here a wedged probe costs one timeout(1) and a failure is a log line.
#
# Groups (the Android-vs-OpenWrt table behind this list is docs/mu300/drivers.md):
#   crypto   CPU crypto offload (AES/PMULL/GHASH/SHA1/ARC4/Twofish). No probe and no device node: it
#            only makes the kernel's crypto API faster, which is what WPA, OpenVPN and Clash pay for.
#   usbnet   USB-Ethernet adapters (asix, ax88179_178a) on the OTG port. Dormant until one is plugged.
#   misc     Vendor glue Android loads at boot: sensor hub, ION heaps, DMA engine, AP/DPU/GSP DVFS,
#            uid/stats/bootreason and the status-LED pattern trigger.
#
# ONLY crypto + usbnet are in GROUPS, because one of the misc modules arms a timer with a NULL
# callback and takes the kernel down with `CFI failure (target: 0x0)` about three seconds after it
# loads (2026-10-16, first adaptation boot). Which one is not known yet, so `vendor-modules bisect`
# walks /etc/mu300/vendor-candidates one batch per 20 s window, records every attempt in
# /root/vendor-bisect.log *before* loading it, and appends what survived to /etc/mu300/vendor-good
# -- which the default path then loads. A batch that kills the kernel leaves TRYING with no OK, and
# the next boot marks it bad and skips it. So the box converges on the largest safe set by itself,
# one reboot per culprit.
#
# Status 2026-10-16: it converged. /etc/mu300/vendor-bad is empty and all 11 batches (13 modules)
# are in /etc/mu300/vendor-good, so load_good() below loads them *every boot*. GROUPS staying at
# "crypto usbnet" is therefore belt-and-braces, not a statement that the misc set is off: what
# actually gates those 13 is vendor-good, and the TRYING/OK pair around good-set is what drops one
# again if it ever starts killing the kernel.
#
# Deliberately NOT here at all:
#   touch (spi-sprd / lcd-state-notify / zte-tpd)
#                    staged, but loading it is opt-in only -- see touch-ctl and the note at the end
#                    of this script.
#   sprdbt_tty       the vendor Bluetooth tty driver is not in this source tree. Only the mainline
#                    6.18 build has it (vermagic 6.18.56), which this kernel cannot load.
#   sprd_u_ether, sprd_usb_f_rndis
#                    the initramfs owns the UDC through configfs; the Android function drivers would
#                    fight it for the same controller.
#   gnss-*, trusty-tui, camera/audio/npu
#                    needs the modem, a TEE session, or source this tree does not carry.
# timeout(1) is not in OpenWrt's busybox -- it comes from the static busybox in /opt/mu300/busybox-bin.
# The init script that runs the default load puts that directory on PATH itself, but bootdiag reaches
# `vendor-modules bisect` from cron, whose PATH is /usr/sbin:/usr/bin:/sbin:/bin.  There, every load
# failed with "timeout: not found" and nothing was ever loaded -- while the bisect still certified the
# batch (2026-10-16).  One script, one PATH: this must not depend on who calls it.
PATH="$PATH:/opt/mu300/busybox-bin:/opt/mu300/bin"
MODDIR=/lib/modules/$(uname -r)
GROUPS="${MU300_VENDOR_GROUPS:-crypto usbnet}"
GOOD=/etc/mu300/vendor-good
BISECT_LIST=/etc/mu300/vendor-candidates
BISECT_BAD=/etc/mu300/vendor-bad
BISECT_LOG=/root/vendor-bisect.log
BISECT_WINDOW=20

loaded() { grep -q "^$(echo "$1" | tr - _) " /proc/modules 2>/dev/null; }

# insmod by path, not modprobe: this tree ships no modules.dep for busybox modprobe to read, and
# modprobe says nothing at all when the .ko is simply absent -- the trap display-modules documents.
load() {
	[ -f "$MODDIR/$1" ] || { echo "MISSING $1 in $MODDIR"; return 0; }
	loaded "$(basename "$1" .ko)" && { echo "already loaded $1"; return 0; }
	if timeout 15 insmod "$MODDIR/$1" 2>/tmp/mu300-vm-$1.err; then
		echo "loaded $1"
	else
		echo "FAILED $1: $(cat /tmp/mu300-vm-$1.err)"
	fi
}

group_crypto() {
	for m in aes-neon-blk aes-ce-ccm ghash-ce sha1-ce arc4 twofish_common twofish_generic; do
		load $m.ko
	done
}

group_usbnet() {
	for m in asix ax88179_178a; do load $m.ko; done
}

group_misc() {
	# Order matters where one module registers a provider another probes against: virt-dma
	# before sprd-dma, ion_ipc_trusty before ion_cma_heap. zlog (bootreason, sensorhub) and
	# kfifo_buf/sipc-core/soc_id/systimer are already up from the boot set.
	for m in virt-dma sprd-dma apsys-dvfs sprd_map misc_sprd_uid ion_ipc_trusty ion_cma_heap \
	         zte_bootreason zte_stats_info board_state smartpa_stat ledtrig-pattern sensorhub; do
		load $m.ko
	done
}

# Everything already proved safe on this box, in the order it was proved. The TRYING/OK pair
# around it is what catches a module that passes its 20 s window on its own but kills the boot
# once the whole set loads: that boot leaves TRYING good-set with no OK, and the next one drops
# the last module of the set (see bisect_verdict) instead of looping on the same panic.
load_good() {
	[ -f "$GOOD" ] || return 0
	echo "TRYING good-set : $(wc -l < $GOOD) modules" >> "$BISECT_LOG"
	sync
	echo "== vendor-good ($(wc -l < $GOOD) modules)"
	while read -r m; do
		case "$m" in ''|\#*) continue ;; esac
		load "$m"
	done < "$GOOD"
	sleep 15
	echo "OK good-set" >> "$BISECT_LOG"
	sync
}

# verdict_of_previous_boot: a boot that died while loading left TRYING with no verdict behind it.
bisect_verdict() {
	last_try=$(grep '^TRYING ' "$BISECT_LOG" 2>/dev/null | tail -1 | awk '{print $2}')
	# Both endings count here: OK (everything went in) and SKIPPED (nothing went in, so nothing was
	# proven).  Only a TRYING with neither behind it means the kernel died inside that window.
	last_done=$(grep -E '^(OK|SKIPPED) ' "$BISECT_LOG" 2>/dev/null | tail -1 | awk '{print $2}')
	[ -n "$last_try" ] || return 0
	[ "$last_try" = "$last_done" ] && return 0
	if [ "$last_try" = good-set ]; then
		# the set as a whole is not safe: drop its last module and record it as bad too, so the
		# bisect cannot hand it straight back
		drop=$(tail -1 "$GOOD" 2>/dev/null)
		[ -n "$drop" ] || return 0
		sed '$d' "$GOOD" > /tmp/.good.new && mv /tmp/.good.new "$GOOD"
		echo "$drop" >> "$BISECT_BAD"
		echo "VERDICT good-set killed the kernel; dropped $drop" >> "$BISECT_LOG"
	else
		echo "$last_try" >> "$BISECT_BAD"
		echo "VERDICT $last_try killed the kernel (no OK after it)" >> "$BISECT_LOG"
	fi
	sync
}

bisect() {
	[ -f "$BISECT_LIST" ] || { echo "no $BISECT_LIST"; return 1; }
	[ -e /tmp/.bisect-ran ] && { echo "already ran this boot"; return 0; }
	: > /tmp/.bisect-ran
	bisect_verdict
	echo "--- run at uptime $(cut -d. -f1 /proc/uptime)s" >> "$BISECT_LOG"
	while read -r name mods; do
		case "$name" in ''|\#*) continue ;; esac
		if grep -qx "$name" "$BISECT_BAD" 2>/dev/null; then
			echo "SKIP $name (known bad)" >> "$BISECT_LOG"
			continue
		fi
		# Recorded *before* the load: if the kernel dies here, this line names the batch.
		echo "TRYING $name : $mods" >> "$BISECT_LOG"
		sync
		for m in $mods; do load "$m" >> "$BISECT_LOG" 2>&1; done
		sleep $BISECT_WINDOW
		# Surviving the window only says the kernel is alive -- it does not say the modules went in.  A
		# load can fail for a mundane reason and leave the kernel running perfectly well, and on
		# 2026-10-16 that is exactly what happened: every module failed with "timeout: not found", the
		# batch was certified OK anyway, and the modules were written into $GOOD as "safe" without ever
		# having been loaded.  So the verdict reads /proc/modules before it believes anything.
		miss= ; for m in $mods; do loaded "${m%.ko}" || miss="$miss $m"; done
		if [ -n "$miss" ]; then
			echo "SKIPPED $name : not loaded:$miss -- nothing proven, not adding to $GOOD" >> "$BISECT_LOG"
			sync
			continue
		fi
		echo "OK $name" >> "$BISECT_LOG"
		for m in $mods; do
			grep -qx "$m" "$GOOD" 2>/dev/null || echo "$m" >> "$GOOD"
		done
		sync
	done < "$BISECT_LIST"
	echo "BISECT-DONE" >> "$BISECT_LOG"
	sync
}

case "$1" in
probe)
	shift
	[ $# -gt 0 ] || { echo "usage: vendor-modules probe MOD.ko ..."; exit 1; }
	for m in "$@"; do load "$m"; done
	;;
bisect) bisect ;;
status)
	echo "groups(default)=$GROUPS"
	echo "--- loaded from our stage dir"
	for m in $MODDIR/*.ko; do
		b=$(basename "$m")
		loaded "${b%.ko}" && echo "  up   $b"
	done
	[ -f "$GOOD" ] && { echo "--- vendor-good"; sed 's/^/  /' "$GOOD"; }
	[ -f "$BISECT_BAD" ] && { echo "--- vendor-bad"; sed 's/^/  /' "$BISECT_BAD"; }
	[ -f "$BISECT_LOG" ] && { echo "--- bisect log (tail)"; tail -12 "$BISECT_LOG" | sed 's/^/  /'; }
	;;
'')
	for g in $GROUPS; do
		case "$g" in
		crypto) group_crypto ;;
		usbnet) group_usbnet ;;
		misc) group_misc ;;
		*) echo "unknown group $g" ;;
		esac
	done
	load_good
	;;
*)
	echo "usage: vendor-modules [probe MOD.ko ...|bisect|status]"
	exit 1
	;;
esac

# The touchscreen stays off unless somebody asked for it by name: `touch-ctl on --persist` writes
# that flag, nothing else does.
[ "$(cat /etc/mu300/touch 2>/dev/null)" = on ] && /opt/mu300/bin/touch-ctl on
true
