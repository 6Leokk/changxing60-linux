#!/bin/sh
# Touchscreen, on demand. DEFAULT IS OFF, and nothing loads it behind your back.
#
# The panel and the digitizer are separate stacks: the picture is sprd-drm (DPU0 + DSI, see
# display-modules) and this is the SPI controller, the ZTE touch framework and the axs15205
# controller driver. The device tree the bootloader hands over already describes the touch panel
# (soc/ap-apb/spi@70000/touch_spi@0, compatible "axs15205,axs15205_touch", status okay) and the
# firmware is compiled into the kernel (CONFIG_EXTRA_FIRMWARE), so the only missing pieces are the
# three modules staged in /lib/modules/$(uname -r) next to the boot set.
#
# That is why this is a script and not a line in an init script: the digitizer on this unit
# misbehaves and its owner asked for touch to stay off, so turning it on is a deliberate act.
#
#   touch-ctl on              load it now (until the next boot)
#   touch-ctl on --persist    load it now and on every boot (/etc/changxing60/touch=on)
#   touch-ctl off             unload it and clear the flag
#   touch-ctl status          what is loaded, and what the input layer sees
#
# If the panel flickers or the pointer jumps while this is on, `touch-ctl off` puts it back without a
# reboot; if the *panel* dies instead (no picture), that is display-modules, not this.
MODDIR=/lib/modules/$(uname -r)
FLAG=/etc/changxing60/touch
# spi-sprd first: the touch controller hangs off its bus, so zte-tpd's probe has nothing to bind to
# until the SPI master is there. lcd-state-notify before zte-tpd -- zte_tpd links against it.
LOAD="spi-sprd lcd_state_notify zte_tpd"

loaded() { grep -q "^$(echo "$1" | tr - _) " /proc/modules 2>/dev/null; }

case "${1:-status}" in
on)
	if [ "${2:-}" = --persist ]; then
		mkdir -p /etc/changxing60
		echo on > $FLAG
		echo "touch will also be loaded on every boot ($FLAG=on)"
	fi
	for m in $LOAD; do
		if [ ! -f "$MODDIR/$m.ko" ]; then
			echo "MISSING $m.ko in $MODDIR"
			continue
		fi
		if loaded "$m"; then
			echo "already loaded $m"
			continue
		fi
		if insmod "$MODDIR/$m.ko" 2>/tmp/changxing60-touch-$m.err; then
			echo "loaded $m"
		else
			echo "FAILED $m: $(cat /tmp/changxing60-touch-$m.err)"
		fi
	done
	sleep 1
	if grep -qi 'axs_ts\|axs15205' /proc/bus/input/devices 2>/dev/null; then
		echo "ok: touch controller is on the input layer"
		grep -i -A4 'axs_ts' /proc/bus/input/devices | grep -E 'Name|Handlers'
	else
		echo "no axs_ts input device: dmesg | grep -i tpd for why"
	fi
	;;
off)
	# reverse order: the framework releases the bus before the bus goes away (no tac: busybox
	# builds differ in whether they ship it, this does not)
	rev=
	for m in $LOAD; do rev="$m $rev"; done
	for m in $rev; do
		loaded "$m" || { echo "$m not loaded"; continue; }
		rmmod "$m" 2>/tmp/changxing60-touch-$m.err && echo "unloaded $m" || \
			echo "FAILED to unload $m: $(cat /tmp/changxing60-touch-$m.err)"
	done
	rm -f $FLAG
	echo "touch off (flag cleared)"
	;;
status)
	for m in $LOAD; do
		loaded "$m" && echo "loaded     $m" || echo "not loaded $m"
	done
	echo "flag: $([ -e "$FLAG" ] && cat $FLAG || echo 'none (off at boot)')"
	grep -i -A4 'axs_ts' /proc/bus/input/devices 2>/dev/null | grep -E 'Name|Handlers' || true
	;;
*)
	sed -n '/^#   touch-ctl/,/^#$/p' "$0" | sed 's/^# \?//'
	exit 1
	;;
esac
true
