#!/bin/sh /etc/rc.common
# Keep the panel's SMS pool in step with the modem (see /opt/changxing60/bin/changxing60-smsd for the whole mechanism).
#
# Nothing started this daemon until now. The pool CLI, the LuCI page and the rpcd backend were all written and
# pass their host-side tests, but with no service the pool only ever moved when somebody ran a command by hand
# -- and "messages arrive while nobody is looking" is the entire point of the background receive.
#
# The pool is /etc, not /var (tmpfs): it has to outlive a reboot, and a reboot is how this device recovers.
# Never /etc/changxing60/sms, which is the sms command's own state directory.
#
# START=95: after init.d/changxing60-at (S19), whose command fifo is what this daemon talks through. It does not
# need the wait spelled out here -- changxing60-smsd waits for that fifo itself, ten minutes at most, and exits so
# that procd starts it again.
START=95
USE_PROCD=1
export PATH="$PATH:/opt/changxing60/busybox-bin"

start_service() {
	procd_open_instance smsd
	procd_set_param command /opt/changxing60/bin/changxing60-smsd
	procd_set_param env CHANGXING60_SMS_POOL=/etc/changxing60/sms-pool
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
