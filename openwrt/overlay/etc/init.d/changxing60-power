#!/bin/sh /etc/rc.common
# Power policy: pin the CPU governor at boot. S96, i.e. after the systems that add load (netifd,
# hostapd, the vendor chroot) exist, so the governor is chosen once the device looks like it will
# look while it runs rather than while it boots.
#
# Nothing here is on the boot critical path: if the governor cannot be set the device still boots and
# serves its hotspot, and the failure is in the log. `power-policy status` prints what is in effect.
START=96
USE_PROCD=1
export PATH="$PATH:/opt/changxing60/bin:/opt/changxing60/busybox-bin"

start_service() {
	/opt/changxing60/bin/power-policy apply || true
}

stop_service() {
	logger -t changxing60-power "stopped (the governor is left as it was)"
}
