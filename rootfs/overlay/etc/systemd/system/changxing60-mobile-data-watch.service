[Unit]
# the vendor modem loader exists only in the 5.4 kernel
ConditionPathExists=|/dev/modem
ConditionPathExists=|/dev/pmsys
Description=changxing60 mobile data watchdog (reconnect after modem resets)
After=changxing60-mobile-data.service
Wants=changxing60-mobile-data.service

[Service]
Type=simple
ExecStart=/opt/changxing60/bin/mobile-data watch
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
