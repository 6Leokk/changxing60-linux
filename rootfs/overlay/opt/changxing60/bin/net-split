#!/bin/sh
# Split the LAN in two: a management link for the USB host, and the hotspot for Wi-Fi clients.
#
# Why this exists. Both used to share br-lan / 192.168.77.0/24, so the single dnsmasq scope
# advertised this device as *router and DNS* to every client -- including the PC on the far end of
# the USB cable. That PC is not a guest on this hotspot; it has its own uplink, and a second
# default route on a management link is simply wrong. On Windows it is not even harmless: measured
# 2026-10-13, the UsbNcm adapter's default route (via 192.168.77.1, interface metric 25) outranked
# the machine's real Wi-Fi uplink (metric 30), so every public destination the local proxy did not
# claim was being routed into this phone's cellular modem. Nothing showed it: the cable kept
# working, the AP kept working, and the PC's traffic quietly changed path.
#
#   usb0     192.168.77.1/24   management -- address only, no router, no DNS
#   br-wifi  192.168.8.1/24    hotspot    -- gateway + DNS = 192.168.8.1, as before
#
# 192.168.77.1 is deliberately unchanged: every tool in this repo, the rescue console and the
# documented `ssh root@192.168.77.1` depend on it. Clients on the hotspot can still reach it -- both
# networks sit in the same firewall zone, so intra-zone forwarding carries the hop.
#
# Idempotent; safe to re-run. Writes uci only -- nothing is applied until the caller reloads
# (net-split --apply does it in the right order).
set -e

LAN_IP=192.168.77.1
WIFI_IP=192.168.8.1

want() { [ "$1" = "--apply" ]; }
apply() {
	/etc/init.d/network reload
	sleep 2
	wifi reload
	sleep 3
	/etc/init.d/dnsmasq restart
	/etc/init.d/odhcpd restart
	/etc/init.d/firewall reload

	# A reload does not restart an interface whose protocol options changed. Measured 2026-10-13:
	# after network.wan.ipv6 appeared, the wan kept its original uptime and its IPv4-only state, and
	# changxing60cell.sh only runs its relay branch on setup -- so an install that was already up would sit
	# there with the relay configured and nothing using it until the next reboot. A fresh install and
	# a boot never need this (the interface is configured after this file lands), and the guard is the
	# bearer's own state, so at most one re-attach happens per install. The wait is bounded: the
	# attach takes up to about 95 s on this modem (registration after the teardown's context release).
	if [ "$(uci -q get network.wan.ipv6)" = relay ] &&
	   ! ip -6 addr show sipa_eth0 2>/dev/null | grep -q 'scope global'; then
		echo "net-split: the bearer has no public IPv6 yet -- re-attaching it so the relay branch runs"
		ifdown wan
		sleep 2
		ifup wan
		for _ in $(seq 1 24); do
			ip -6 addr show sipa_eth0 2>/dev/null | grep -q 'scope global' && break
			sleep 5
		done
		if ip -6 addr show sipa_eth0 2>/dev/null | grep -q 'scope global'; then
			echo "net-split: relay live, bearer $(ip -6 -o addr show dev sipa_eth0 scope global | awk '{print $4}' | head -1)"
		else
			echo "net-split: the bearer still has no public IPv6 -- check that the APN is IPv4/IPv6 and the signal is there"
		fi
	fi

	# The prefix route to the hotspot exists only while this runs (see ndp-learn for the whole reason).
	# restart picks up a changed option when the service is already up; when it is not, procd answers
	# the stop half with "Not found", which is expected here and only noise on the operator's terminal.
	/etc/init.d/changxing60-ndp enable
	/etc/init.d/changxing60-ndp restart 2>/dev/null
}

# --- the hotspot gets its own bridge and its own address -------------------------------
# Standalone-safe seeding first. This image ships no /etc/config/network at all (the armsr base has
# none and upstream's defaultconfig generator is not in the rootfs -- checked 2026-10-17 against the
# flash tarball), `uci set` refuses to write options into a package or section that does not exist,
# and with `set -e` above the script then dies *here*, before the bottom-of-file commits, so even the
# writes that had succeeded stayed in uci's staging file and evaporated. That is conflicts.md B1 in
# full: not just ap0 at S10, but every first write on a virgin tree. When the sections exist (any
# normal install, and the uci-defaults pass that now seeds them), each guard below is a no-op.
touch /etc/config/network
uci -q show network.lan >/dev/null 2>&1 || {
	uci -q set network.brlan=device
	uci -q set network.brlan.name='br-lan'
	uci -q set network.brlan.type='bridge'
	uci -q set network.lan=interface
	uci -q set network.lan.proto='static'
	uci -q set network.lan.device='br-lan'
	uci -q set network.lan.ipaddr="$LAN_IP"
	uci -q set network.lan.netmask='255.255.255.0'
}
uci -q show network.wan >/dev/null 2>&1 || uci -q set network.wan=interface
uci -q set network.brwifi=device
uci -q set network.brwifi.name='br-wifi'
uci -q set network.brwifi.type='bridge'
uci -q set network.wifi=interface
uci -q set network.wifi.device='br-wifi'
uci -q set network.wifi.proto='static'
uci -q set network.wifi.ipaddr="$WIFI_IP"
uci -q set network.wifi.netmask='255.255.255.0'
uci -q set network.wifi.ip6assign='60'     # parity: Wi-Fi clients kept their IPv6 addresses
# the AP leaves the management bridge. On a virgin first boot this script runs from uci-defaults at
# S10, two levels *before* openwrt-wifi-config (S12, via changxing60-hw) creates /etc/config/wireless
# and its ap0 section -- and `uci set` on a section that does not exist exits 1, which under `set -e`
# above used to abort the whole script right here: every write below it (the firewall zone that puts
# the hotspot where fw4 accepts it, dhcp.wifi, the management link's no-gateway options, the IPv6
# relay) stayed in uci's staging file and was never committed, exactly once, because uci-defaults has
# no second run (docs/changxing60/conflicts.md B1; the visible failure was clients associating,
# finishing the handshake and getting nothing). So: make the file and the section exist if nobody has
# yet. openwrt-wifi-config regenerates this file via `wifi config` and sets ap0 from its own batch
# afterwards, so both orders land on the same result.
touch /etc/config/wireless
uci -q show wireless.ap0 >/dev/null 2>&1 || uci -q set wireless.ap0=wifi-iface
uci -q set wireless.ap0.network='wifi'

# --- the management link hands out an address and nothing else -------------------------
# An option listed with no value is how dnsmasq is told to send it empty: the client gets no
# router and no DNS from this side, and falls back to whatever it already had.
uci -q delete dhcp.lan.dhcp_option || true
uci -q add_list dhcp.lan.dhcp_option='3'
uci -q add_list dhcp.lan.dhcp_option='6'
uci -q set dhcp.lan.dhcpv6='disabled'      # and no IPv6 router either -- the RA carried one
uci -q set dhcp.lan.ra='disabled'

# --- the hotspot keeps a normal scope --------------------------------------------------
uci -q delete dhcp.wifi || true
uci -q set dhcp.wifi=dhcp
uci -q set dhcp.wifi.interface='wifi'
uci -q set dhcp.wifi.start='100'
uci -q set dhcp.wifi.limit='150'
uci -q set dhcp.wifi.leasetime='12h'
uci -q set dhcp.wifi.dhcpv4='server'
uci -q set dhcp.wifi.dhcpv6='server'
uci -q set dhcp.wifi.ra='server'
uci -q set dhcp.wifi.ra_slaac='1'
uci -q delete dhcp.wifi.ra_flags || true
uci -q add_list dhcp.wifi.ra_flags='managed-config'
uci -q add_list dhcp.wifi.ra_flags='other-config'

# --- one zone, so hotspot clients can still reach the management address ---------------
uci -q delete firewall.@zone[0].network || true
uci -q add_list firewall.@zone[0].network='lan'
uci -q add_list firewall.@zone[0].network='wifi'

# --- IPv6, split the same way --------------------------------------------------------
# The carrier only ever gives this device one IPv6 address per bearer, and it hands the prefix out
# by router advertisement rather than in +CGCONTRDP (that field carries the interface identifier
# with the prefix zeroed -- measured here: address ::18dd:fcd3:369a:2978, prefix 0). So there is no
# prefix to delegate and nothing to configure statically: the bearer takes the advertisement
# (network.wan.ipv6 relay, see changxing60cell.sh for the ordering that actually makes the carrier answer)
# and odhcpd relays it to the hotspot, whose clients SLAAC their own addresses out of the carrier's
# /64. Return traffic is rewritten to this device's own address by NAT66, because the carrier routes
# the one address it assigned and would drop a reply addressed to a client.
#
# The management link is left out, exactly as it is for IPv4 and for the same measured reason: the
# PC on the far end of the cable has its own uplink, and a router advertisement there is a second
# default route competing with it. So br-lan advertises nothing (below) and the relay is wired to
# br-wifi only.
uci -q set network.wan.ipv6='relay'
# odhcpd relay: 'wan' is the master -- the interface that owns the bearer, so it is where the
# carrier's RS/RA and DHCPv6 are picked up -- and the hotspot relays them to its clients both ways.
# No separate wan6 interface is involved; there is nothing for one to do.
uci -q delete dhcp.wan || true
uci -q set dhcp.wan=dhcp
uci -q set dhcp.wan.interface='wan'
uci -q set dhcp.wan.master='1'
uci -q set dhcp.wan.ra='relay'
uci -q set dhcp.wan.dhcpv6='relay'
uci -q set dhcp.wifi.ra='relay'
uci -q set dhcp.wifi.dhcpv6='relay'
# odhcpd's NDP relay is off, deliberately (upstream's security review of the same port). With
# ndproxy_routing on -- its default -- every neighbour entry on the LAN becomes a /128 route to that
# LAN, and any host creates such an entry for any address with one spoofed neighbour solicitation,
# off-prefix included: a route hijack. NAT66 rewrites every client source to this device's own
# address, so the carrier never needs to resolve a client address. Any value someone set is removed.
# Every delete is guarded: `uci delete` on an option that is not there exits 1, and with `set -e`
# above a bare one aborts the whole script -- which is exactly what happened the first time this ran
# (the script died on the first iteration of this loop, so the NAT66 and the commits below never
# executed and the entire run sat in uci's staging file, one reboot away from being lost).
for o in dhcp.lan.ndp dhcp.wan.ndp dhcp.wifi.ndp \
         dhcp.lan.ndproxy_routing dhcp.wan.ndproxy_routing dhcp.wifi.ndproxy_routing; do
	uci -q delete $o || true
done
# NAT66 egress. On the wan zone, so an install whose zone has another name still gets it when the
# zone is found -- and so nothing is written where there is no wan zone to write to. (`uci show`
# prints the anonymous section as `firewall.@zone[1]`, which is what the substitution captures.)
zone=$(uci -q show firewall | sed -n "s/^\(firewall\.@zone\[[0-9]*\]\)\.name='wan'$/\1/p")
if [ -n "$zone" ]; then
	uci -q set $zone.masq6='1'
fi

uci commit network
uci commit wireless
uci commit dhcp
uci commit firewall

echo "net-split: usb0=$LAN_IP/24 (address only), br-wifi=$WIFI_IP/24 (gateway+dns)"
echo "net-split: IPv6 relayed to br-wifi only (NAT66 on the wan zone); br-lan stays without IPv6"
want "$1" && { apply; echo "net-split: applied"; }
exit 0
