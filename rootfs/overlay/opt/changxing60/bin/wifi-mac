#!/bin/sh
# Give wlan0 this board's factory MAC, before anything starts an AP on it.
#
# Without this the AP's BSSID is a fresh random 40:45:da:xx address every boot -- the same AP, a
# different identity each time. The chip reports no MAC of its own (the firmware's GET_INFO answer
# carries an invalid address) and nothing in this stack feeds it one, so the driver's
# iface_set_mac_addr() falls through to random_ether_addr().
#
# The board does have a factory MAC. It is in the prodnv partition, which Android mounts at
# /mnt/vendor -- exactly the path the driver names in WIFI_MAC_ADDR_PATH; that macro is dead code
# here, the vendor's own HAL is what applies it. So mount it read-only and apply the address with
# /usr/bin/wifimac, which is the vendor's SPRDWLSETNDEVMAC ioctl.
#
# `ip link set wlan0 address <mac>` cannot do this: the driver's ndo_set_mac_address
# (iface_set_mac) handles only the station and P2P cases and otherwise returns 0 without changing
# anything, which is why a pinned macaddr used to look ignored. See tools/screen/wifimac.c.
#
# Called from changxing60-hw (S12) right after wifi-start, i.e. before netifd starts hostapd -- so the
# address is in place before anything reads it, including changxing60-hw's own pin of
# wireless.ap0.macaddr a few lines further down, which is what keeps hostapd's bssid and the real
# interface from disagreeing. It is re-applied every boot because the driver's idea of the address
# does not survive a reload.
NV=/dev/block/by-name/prodnv
MNT=/mnt/vendor

[ -e /sys/class/net/wlan0 ] || { echo "wifi-mac: no wlan0, skipped"; exit 0; }
mkdir -p "$MNT"
grep -q " $MNT " /proc/mounts || mount -o ro "$NV" "$MNT" 2>/dev/null || {
	echo "wifi-mac: cannot mount $NV at $MNT"
	exit 0
}
[ -s "$MNT/wifimac.txt" ] || { echo "wifi-mac: $MNT/wifimac.txt is missing or empty"; exit 0; }
exec /usr/bin/wifimac
