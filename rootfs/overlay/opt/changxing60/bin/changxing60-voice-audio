#!/usr/bin/env python3
"""changxing60-voice-audio -- the audio half of a phone call on the ZTE 7552N (changxing60).

WHAT THIS IS. A call has two halves. The control half -- ATD/ATA/AT+CHUP, the ringing state, the
caller's number -- is changxing60-voiced and changxing60-voice, and it works. The audio half is the
AGDSP: the modem's voice stream goes into the VBC block, gets its parameters from a profile the
kernel holds, and comes out of the codec into the earpiece or the speaker. Nothing drives that
today, which is why a call connects and neither side hears anything. This program drives it.

changxing60-voiced calls `changxing60-voice-audio start` when a call comes up and `... stop` when it
ends, and ignores the exit status (a call with no audio is still a call the panel can show). So
`start` forks a monitor that holds the PCM open and returns immediately, and `stop` signals it.

HOW THE VOICE PATH WORKS, in the order it has to be done:

  1. FE_ST_VOICE (hw:0,5) is a HOSTLESS PCM pair: no audio is copied through userspace. The AP side
     opens it only so the routing and the DSP scene exist; the samples themselves go straight between
     the modem DSP and the codec inside the AGDSP. Opening playback is not enough to start it --
     ALSA refuses to start an empty playback stream, so the application pointer is pushed forward
     with SNDRV_PCM_IOCTL_FORWARD and no samples are ever written. Writing samples would be wrong,
     not just unnecessary.
  2. The profile Select controls pick which parameter set the DSP runs. Their 32-bit word is
     (mode_offset << 24) | (param_id << 16) | dsp_case. Only the top byte selects data; the rest is
     opaque to the driver and travels to the DSP. See MODES below -- the mode numbers are the one
     number in this file that belongs to this machine's parameter table and not to the driver.
  3. The routes (S_VOICE_P_CODEC SWITCH etc.) connect FE_ST_VOICE to the codec, and the output tables
     connect the codec to the earpiece or the speaker.
  4. The vendor applies the parameters AGAIN after both PCMs start, so the Select sequence runs
     twice. It also resets gain, so the volume is reapplied before the downlink mute is released.
  5. The downlink stays muted (VBC_DL_MUTE) for every route change and is released only when the new
     route is fully up. A cached "already unmuted" is not evidence that the DSP is unmuted.

WHY RAW IOCTLS FOR THE MIXER. The Select controls declare max 0x0fffffff, and a Select word is
(mode << 24) | (mode << 16) | 5, so the mode number has to fit in the top byte. For the handset and
handsfree modes, all below 16, the word fits under that maximum and amixer would pass it through --
but for the Bluetooth modes, 28 and up, it does not, and then amixer clamps SILENTLY. Measured on
this board: writing 0x1C1C0005 through amixer reads back 0x0FFFFFFF, while the raw ioctl carries
0x1C1C0005, 0x10100005 and 0x07070005 all through unchanged. A clamped word is not a rejected
write, it is a different mode applied without a word of complaint, so the mixer is driven directly
(SNDRV_CTL_IOCTL_ELEM_INFO/READ/WRITE) and never through amixer or the alsa-lib simple-mixer layer.
libasound is still used for the PCM, where it is the only sane way to negotiate hw_params.

WHY NOTHING HERE TOUCHES THE MODEM. This program does not open /dev/stty_nr1 or any AT channel, does
not create, answer or end calls, and does not know a call's state. It is told to start and to stop.
Everything it writes goes to the sound card, /dev/audio_pipe_voice and /dev/vbc_turningN.

Ported from e5-linux's e5-call-audio.py (VIPME M8, same UMS9620/SC2730 family, verified working
there); the mixer layer is e5's e5-ctl-raw ABI reimplemented, and the route tables are e5's. See
docs/changxing60/telephony.md and docs/changxing60/vbc-profile.md.
"""
import ctypes
import errno
import fcntl
import math
import os
import re
import select
import signal
import struct
import sys
import threading
import time

# --------------------------------------------------------------------------------------------
# CALIBRATION: the one table in this file that is this machine's and not the driver's.
#
# A profile Select word is (mode_offset << 24) | (param_id << 16) | dsp_case, where mode_offset
# indexes a mode inside the audio_structure profile blob and dsp_case is VBC_DAI_ID_VOICE = 5.
# The mode numbering is a property of the parameter table, so it is per-machine and cannot be read
# out of the driver.
#
# These numbers are e5's (M8) table, which is the same SoC family. The supporting evidence, measured
# on this box rather than assumed: our /lib/firmware/audio_structure is 67 modes of 730 bytes, the
# same layout e5 reads, and the 7-entry gain curve at +0x244 has a sensible loudness ordering at
# exactly these indices -- handset (0,2,4,5) peaks at 917, 817, 5157, 8173; handsfree (7,9,11,12)
# at 1631, 2053, 2584, 32536; bluetooth (28,30,32,33) flat at 8173. That is what a per-band table
# should look like, and `selftest` prints it so the next person can see the same numbers.
#
# It is still not proof, and one number is actively suspicious: handset mode 2 peaks slightly BELOW
# mode 0, so the narrowband/wideband pair does not separate the way the other two groups do. What
# would settle the table is listening to a real call at each index and comparing. Until then these
# are overridable from the config file (see MODE_KEYS) and every Select is logged with its index.
MODES = {
    'handset':   (0, 2, 4, 5),      # narrowband, wideband, super-wideband, fullband
    'handsfree': (7, 9, 11, 12),
    'bluetooth': (28, 30, 32, 33),
}
MODE_KEYS = {
    'mode-handset-nb': ('handset', 0), 'mode-handset-wb': ('handset', 1),
    'mode-handset-swb': ('handset', 2), 'mode-handset-fb': ('handset', 3),
    'mode-handsfree-nb': ('handsfree', 0), 'mode-handsfree-wb': ('handsfree', 1),
    'mode-handsfree-swb': ('handsfree', 2), 'mode-handsfree-fb': ('handsfree', 3),
    'mode-bluetooth-nb': ('bluetooth', 0), 'mode-bluetooth-wb': ('bluetooth', 1),
    'mode-bluetooth-swb': ('bluetooth', 2), 'mode-bluetooth-fb': ('bluetooth', 3),
}
DAI_ID_VOICE = 5
BAND_NAMES = ('narrowband', 'wideband', 'super-wideband', 'fullband')

# The analog codec gains. e5 reads these per scene out of the Android parameter XML
# (/odm/etc/audio_params/sprd/codec.xml); we have no XML here and nothing has set them on this
# board, so these are e5's fallback values, clamped to whatever the card declares. They are a
# starting point, not a calibration -- an analog stage that is too loud clips before the DSP ever
# gets a chance to attenuate, and one that is too quiet cannot be recovered in the DSP either.
# Overridable per key from the config file.
GAIN_DEFAULTS = {
    'gain-dac-receiver': 3, 'gain-dac-speaker': 3,
    'gain-ao-receiver': 6, 'gain-ao-speaker': 4,
    'gain-ear-nb': 2, 'gain-ear-wb': 2, 'gain-ear-swb': 2, 'gain-ear-fb': 4,
}
# Byte offset of the 7-entry u16 gain curve inside one audio_structure mode (e5's layout; our blob
# is the same len_mode=0x2da and the curve is monotonic in all 67 modes, so it reads correctly).
VOLUME_CURVE_OFFSET = 0x244
VOLUME_CURVE_ENTRIES = 7

# --------------------------------------------------------------------------------------------
# Paths. Every one is overridable so the host-side tests can run without a sound card.
RUN = os.environ.get('CHANGXING60_VOICE_AUDIO_RUN', '/run/changxing60-voice-audio')
CONF = os.environ.get('CHANGXING60_VOICE_AUDIO_CONF', '/etc/changxing60/voice-audio.conf')
LOG = os.environ.get('CHANGXING60_VOICE_AUDIO_LOG', '/root/voice-audio.log')
FIRMWARE = os.environ.get('CHANGXING60_VOICE_AUDIO_FIRMWARE', '/lib/firmware')
PCM_STATUS = os.environ.get('CHANGXING60_VOICE_AUDIO_PROC', '/proc/asound')
PIPE_VOICE = os.environ.get('CHANGXING60_VOICE_AUDIO_PIPE', '/dev/audio_pipe_voice')
TURNING = os.environ.get('CHANGXING60_VOICE_AUDIO_TURNING', '/dev/vbc_turning%d')

PIDFILE = os.path.join(RUN, 'pid')
STATEFILE = os.path.join(RUN, 'state')
CTLFIFO = os.path.join(RUN, 'ctl')

# A call is 8000 Hz S16 mono, and the FE is a 640-frame period in a 1280-frame buffer.
VOICE_RATE = 8000
VOICE_PERIOD = 640
VOICE_BUFFER = 1280

AUDIO_PIPE_WAKEUP = 0x40044100          # _IOW('A', 0, int), audio-pipe.c AUDIO_PIPE_WAKEUP
AUD_SMSG = struct.Struct('<HH4I')       # struct aud_smsg, audio-smsg.h
AUD_SMSG_SIZE = AUD_SMSG.size           # 20
# 20-byte messages on the voice pipe, from the AGDSP.
MSG_BANDWIDTH = (0x00, 2)               # command, channel: parameter1 = 0..3 = NB/WB/SWB/FB
MSG_CP_VOICE = (0x35, 2)                # command, channel: CP voice enabled, parameter0 = mask

CARD_NAME = 'sprdphone-sc2730'

# --------------------------------------------------------------------------------------------
