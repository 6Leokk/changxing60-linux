#!/bin/bash
# Mobile data on the changxing60 modem without Android RIL: AT commands through the changxing60-atd daemon (init.d/changxing60-at),
# data over sipa_eth<cid-1>. The daemon owns /dev/stty_nr1 and this script is one of its clients; only when the
# service is not running does this script fall back to opening the channel itself (see at()).
# usage: mobile-data up [APN] | down | status | sim-reset | cp-reset | watch
# CHANGXING60_NETIFD=1 mobile-data up [APN]: only attach and print IFACE/IP/PREFIX/DNS1/DNS2 (OpenWrt netifd protocol)
# OpenWrt: od/timeout come from the static busybox in /opt/changxing60/busybox-bin
export PATH="$PATH:/opt/changxing60/busybox-bin"
set -euo pipefail
DEV=${CHANGXING60_AT_DEV:-/dev/stty_nr1}
CID=1
IFACE=sipa_eth$((CID - 1))

# The AT daemons, by the same layout changxing60-at uses (see init.d/changxing60-at). MAIN_DIR is nr1, the channel every
# AT user on the device shares. DATA_DIR is nr2, this script's own, and exists only when /etc/changxing60/at-split
# is set -- the dial has only ever run on nr1 here, so moving it is something to measure, not to assume.
MAIN_DIR=${CHANGXING60_AT_DIR:-/run/changxing60-at}
DATA_DIR=${CHANGXING60_AT_DATA_DIR:-/run/changxing60-at2}
# CHANGXING60_AT_BIN is a test seam (tools/mobile-data/test-at-dispatch.sh): the client is replaced, not the daemon.
AT_BIN=${CHANGXING60_AT_BIN:-/opt/changxing60/bin/changxing60-at}

# Is a live changxing60-atd (or a previous mobile-data that took the direct path) holding DIR? Then the channel is
# not ours to open: on a SIPC tty each line goes to exactly one reader, so a second one takes a random half of
# every reply away from the first, and neither sees a whole answer. Same guard, same wording, as changxing60-at's.
owner_holds() {  # owner_holds DIR
    local owner
    owner=$(cat "$1/owner/pid" 2>/dev/null || true)
    [ -n "$owner" ] && [ -d "/proc/$owner" ] &&
        { tr '\0' ' ' < "/proc/$owner/cmdline"; } 2>/dev/null | grep -qE 'changxing60-atd|mobile-data'
}

# stty may only configure the tty when this script is the one that opened it. With a daemon running the
# channel belongs to it, and reaching for the termios from here is the kind of second access the driver's
# one-reader rule is about -- it also does nothing useful, since the daemon already set the port raw.
own_tty() {  # own_tty: true when no daemon is holding either channel
    [ ! -p "$DATA_DIR/cmd" ] || return 1
    [ ! -p "$MAIN_DIR/cmd" ] || return 1
    return 0
}

# at CMD [TIMEOUT] -> the reply lines, up to the final result code.
#
# Through the daemon whenever one is running: it owns the channel, drains the unsolicited lines that would
# otherwise be read as this command's reply, and serializes every AT user on the device behind one lock. That
# is the point of the service -- mobile-data used to open nr1 for itself on every command, so the attach, the
# SMS stack and anything else asking the modem at the same time each got half of the other's answers.
#
# The direct open at the bottom is the old behaviour, kept for the case where the service did not start (and
# for a kernel or a test layout without it). It closes the channel after every command, which is the one
# operation changxing60-atd warns can leave a SIPC tty silent until a reboot, so it is a fallback, not a preference.
#
# Returns 0 whenever the channel was reached, whatever the modem answered: every caller greps the text and
# `set -e` is on, so a non-zero status would end the attach instead of letting the caller's own test decide.
# Non-zero means only "there was no channel to ask".
at() {
    local cmd=$1 t=${2:-5} line out dir=
    if [ -p "$DATA_DIR/cmd" ]; then dir=$DATA_DIR
    elif [ -p "$MAIN_DIR/cmd" ]; then dir=$MAIN_DIR
    fi
    if [ -n "$dir" ]; then
        # the daemon answers in ~20 ms; changxing60-at waits out the lock and the command's own timeout on top
        out=$(CHANGXING60_AT_DIR="$dir" "$AT_BIN" -t "$t" "$cmd" 2>/dev/null) || true
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    fi
    if owner_holds "$DATA_DIR" || owner_holds "$MAIN_DIR"; then
        echo "mobile-data: pid holds the AT channel but its command fifo is gone; restart changxing60-atd" >&2
        return 1
    fi
    [ -c "$DEV" ] || return 1   # never let the redirection create a regular file in /dev
    exec 3<>"$DEV"
    # drop late responses/URCs left over from earlier commands
    while IFS= read -r -t 0.2 line <&3; do :; done
    printf '%s\r' "$cmd" >&3
    local end=$((SECONDS + t))
    while [ $SECONDS -lt $end ]; do
        IFS= read -r -t 1 line <&3 || continue
        line=${line%$'\r'}
        [ -z "$line" ] && continue
        case "$line" in
            +CSQ:*|+CESQ:*|+SPPCI:*|+ECIND:*|+SIND:*|+CREG:*|+CGREG:*|+SPNRINDICATE:*|+CTZV:*|^CONN:*|+SPERRLOG:*)
                [ "${cmd#AT+CSQ}" != "$cmd" ] && [ "${line#+CSQ:}" != "$line" ] && echo "$line"
                continue ;;
        esac
        echo "$line"
        case "$line" in OK|ERROR|+CME\ ERROR*|+CMS\ ERROR*|CONNECT*|NO\ CARRIER) break ;; esac
    done
    exec 3>&-
}

# The modem needs the vendor modem loader/SIPC drivers (5.4 kernel); a kernel without them (mainline) has no modem.
modem_stack() { [ -e /dev/modem ] || [ -e /dev/pmsys ] || [ -c "$DEV" ]; }

# Only one attach may own the AT port at a time.
# netifd retries a failed setup every ~20 s (proto_setup_failed), but an attach can sit in the 60x2 s
# registration wait below for over two minutes, so every retry forks another `mobile-data up` onto
# the same port and they all fight over the same AT responses. That is how the 2026-10-13 storm was
# built -- five stacked attaches, an AT channel that answered nothing, and a modem that only came
# back on a reboot. The second caller now fails fast instead: netifd will retry, and by then the
# first attach has either finished or released the lock.
ATTACH_LOCK=/var/run/changxing60-attach.lock

up_locked() {
    if ! mkdir "$ATTACH_LOCK" 2>/dev/null; then
        local p
        p=$(cat "$ATTACH_LOCK/pid" 2>/dev/null) || p=   # set -e: a missing pid file is not fatal
        if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
            echo "another attach (pid $p) already owns $DEV" >&2
            exit 4
        fi
        rm -rf "$ATTACH_LOCK"                       # owner died without cleaning up
        mkdir "$ATTACH_LOCK" 2>/dev/null || { echo "attach lock busy" >&2; exit 4; }
    fi
    echo $$ > "$ATTACH_LOCK/pid"
    trap 'rm -rf "$ATTACH_LOCK"' EXIT INT TERM
    up "$@"
}

up() {
    modem_stack || { echo "no modem stack in this kernel ($(uname -r))" >&2; exit 3; }
    rm -f /run/changxing60-mobile-data-down
    # some tty flags are not supported by the modem tty; only while this script owns it (see own_tty)
    if own_tty; then stty -F "$DEV" raw -echo 2>/dev/null || true; fi
    at 'AT+CFUN?' | grep -q '+CFUN: 1' || { at 'AT+SFUN=2' 5 >/dev/null; at 'AT+SFUN=4' 15 >/dev/null; }
    for n in $(seq 1 60); do
        at 'AT+CEREG?' | grep -qE '\+CEREG: [0-9],(1|5)' && break
        # the radio can be switched off again meanwhile (modem reset), so re-check it every 10 s
        if [ $((n % 5)) -eq 0 ] && ! at 'AT+CFUN?' | grep -q '+CFUN: 1'; then
            at 'AT+SFUN=2' 5 >/dev/null; at 'AT+SFUN=4' 15 >/dev/null
        fi
        sleep 2
    done
    at 'AT+CEREG?' | grep -qE '\+CEREG: [0-9],(1|5)' || { echo "not registered on the network" >&2; exit 1; }
    if [ -n "${1:-}" ]; then
        at "AT+CGDCONT=$CID,\"IPV4V6\",\"$1\"" >/dev/null
    fi
    at "AT+CGACT?" | grep -q "+CGACT:$CID,1" || at "AT+CGACT=1,$CID" 20 >/dev/null
    rdp=$(at "AT+CGCONTRDP=$CID" 4 | grep '^+CGCONTRDP:' | head -1)
    # +CGCONTRDP: cid,bearer,apn,"a.b.c.d.m.m.m.m",gw,dns1,dns2,...
    addrmask=$(echo "$rdp" | cut -d, -f4 | tr -d '"')
    ip4=$(echo "$addrmask" | cut -d. -f1-4)
    mask=$(echo "$addrmask" | cut -d. -f5-8)
    dns1=$(echo "$rdp" | cut -d, -f6 | tr -d '"')
    dns2=$(echo "$rdp" | cut -d, -f7 | tr -d '"')
    [ -n "$ip4" ] || { echo "no IPv4 address from AT+CGCONTRDP" >&2; exit 1; }
    at "AT+CGDATA=\"M-ETHER\",$CID" 8 | grep -q CONNECT || true
    prefix=$(python3 -c "import ipaddress,sys;print(ipaddress.IPv4Network('0.0.0.0/'+sys.argv[1]).prefixlen)" "$mask" 2>/dev/null || echo 32)
    if [ "${CHANGXING60_NETIFD:-0}" = 1 ]; then
        # OpenWrt: netifd (proto changxing60cell) configures the address, routes, DNS and firewall itself
        printf 'IFACE=%s\nIP=%s\nPREFIX=%s\nDNS1=%s\nDNS2=%s\n' "$IFACE" "$ip4" "$prefix" "$dns1" "$dns2"
        return 0
    fi
    ip link set "$IFACE" up
    # The sipa driver hands up wrong hardware checksums ("hw csum failure" warnings), so the
    # checksum has to be verified in software. Caveat worth knowing before trusting this line:
    # the OpenWrt rootfs has no ethtool at all (not even a busybox applet), so on this device the
    # call below has never actually done anything. It is kept for layouts that do have it; the
    # netifd path (proto changxing60cell) does not reach here and carries the same no-op for parity.
    # Whether the 2026-10-13 outage was this or a wedged PDP context is unresolved -- the packets
    # were not leaving the interface at all, which a bad checksum would not explain.
    ethtool -K "$IFACE" rx off 2>/dev/null || true
    ip addr flush dev "$IFACE"
    ip addr add "$ip4/$prefix" dev "$IFACE"
    ip route replace default dev "$IFACE" metric 100
    if command -v resolvectl >/dev/null; then
        resolvectl dns "$IFACE" $dns1 $dns2 || true
        resolvectl domain "$IFACE" '~.' || true
    fi
    # share the connection with USB/Wi-Fi clients (dnsmasq on usb0 already hands out this device as router/DNS)
    sysctl -qw net.ipv4.ip_forward=1
    nft -f - <<NFT
table ip changxing60_nat
delete table ip changxing60_nat
table ip changxing60_nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "$IFACE" masquerade
    }
    chain forward {
        type filter hook forward priority filter; policy accept;
        tcp flags syn tcp option maxseg size set rt mtu
    }
}
NFT
    [ -w /sys/class/leds/sc27xx:blue/brightness ] && echo 255 > /sys/class/leds/sc27xx:blue/brightness
    echo "mobile data up on $IFACE ($(at 'AT+COPS?' | sed -n 's/^+COPS: [0-9],[0-9],"\([^"]*\)".*/\1/p'))"
}

down() {
    touch /run/changxing60-mobile-data-down   # tells watch not to reconnect
    [ -w /sys/class/leds/sc27xx:blue/brightness ] && echo 0 > /sys/class/leds/sc27xx:blue/brightness
    nft delete table ip changxing60_nat 2>/dev/null || true
    ip route del default dev "$IFACE" 2>/dev/null || true
    ip addr flush dev "$IFACE" 2>/dev/null || true
    ip link set "$IFACE" down 2>/dev/null || true
    # some tty flags are not supported by the modem tty; only while this script owns it (see own_tty)
    if own_tty; then stty -F "$DEV" raw -echo 2>/dev/null || true; fi
    at "AT+CGACT=0,$CID" 10 >/dev/null || true
}

sim_reset() {
    # some tty flags are not supported by the modem tty; only while this script owns it (see own_tty)
    if own_tty; then stty -F "$DEV" raw -echo 2>/dev/null || true; fi
    at 'AT+SFUN=5' 20; at 'AT+SFUN=3' 10; sleep 2; at 'AT+SFUN=2' 10; at 'AT+SFUN=4' 30
    for _ in $(seq 1 30); do at 'AT+CPIN?' | grep -q READY && break; sleep 2; done
    at 'AT+CPIN?'
}

# Liveness is read from the interface, never from the modem. Without /etc/changxing60/at-split the data call and
# the AT channel are one port -- up() ends with AT+CGDATA="M-ETHER",1 on nr1 -- so the old
# `stty` + AT+CGACT? poll aimed command traffic at a port that was busy carrying data, and its
# two-strikes branch answered a missed reply with `ifup wan`: a second attach on the port that was
# already attached. That is the shape of the 2026-10-13 outage -- five stacked `mobile-data up`
# processes, load 14, and an AT channel that answered nothing (not even a bare "AT") until the modem
# was rebooted.
# What is measured: with the poll gone the call stays up well past the old ~180 s mark, across
# reboots, and a loop that replays the old poll cadence on a healthy call does not by itself kill it.
# So the AT traffic is at best unnecessary; the attach storm is what takes the port down. The watch
# never needs the modem anyway: losing the call takes the address off $IFACE, which is what we key on
# (the Ubuntu layout behaves the same).
link_up() {
    ip -4 addr show "$IFACE" 2>/dev/null | grep -q inet || return 1
    # "unknown" is a legitimate operstate for a device that never had a carrier report: only a
    # definite "down" counts against the call.
    [ "$(cat /sys/class/net/$IFACE/operstate 2>/dev/null)" != down ]
}

# link_up() is only half of "the call is alive", and the weaker half. A wedged data call keeps its
# address, keeps operstate up and keeps reporting a healthy netdev: on 2026-10-13 the status page
# showed sipa_eth0 up in green for the whole 4.7 h boot while the interface moved zero packets in
# either direction and every downstream client sat at "connected, no internet". Nothing reconnected
# it, because the only thing being tested was the address -- which was never wrong.
# Hence a probe of the far side. ICMP because this carrier answers it and because it does not touch
# the AT port, which is the rule that matters here (see the note above link_up). Several targets,
# so one unreachable address cannot be mistaken for a dead call.
wan_probes() {
    local l
    l=$(sed -n 's/^nameserver //p' /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null | head -2)
    echo "$l 223.5.5.5 119.29.29.29"
}

probe_ok() {
    local t
    for t in ${WAN_PROBES:-223.5.5.5}; do
        ping -c 1 -W 3 -I "$IFACE" "$t" >/dev/null 2>&1 && return 0
    done
    return 1
}

# Published for the status page, which otherwise has nothing to go on but operstate -- the very
# signal that lied above. "<ok|dead> <uptime-seconds>".
set_health() {
    local up
    [ "$1" = ok ] && rm -f "$CP_MARK"   # a healthy call ends the outage: a later one may CP-restart again
    read -r up _ < /proc/uptime 2>/dev/null || up=0
    printf '%s %s\n' "$1" "${up%.*}" > /tmp/.changxing60-wan-health &&
        mv /tmp/.changxing60-wan-health /tmp/changxing60-wan-health
}

# ---------------------------------------------------------------------------
# Last resort: reboot the phone.
#
# Everything above assumes the modem still answers. When it stops answering, none of it can work, and
# on 2026-10-13 that is exactly what happened: sipa_eth0 went down at 1066 s uptime, `mobile-data up`
# then blocked in select() on /dev/stty_nr1 and printed nothing at all, and it stayed that way through
# killing the stuck attach, removing the lock and attaching from scratch -- the new pids blocked in
# select too. `ifup` cannot help, and neither can `sim_reset`, whose AT commands go to the very port
# that is dead. The WCN side is innocent: `echo AT > /sys/devices/virtual/misc/wcn/devices/atcmd`
# still returned 0 all the way through (that is hotspot-watch's probe, not this one). Only a reboot
# brought the AT channel back, and it did so immediately.
#
# So when the call has been unusable for CHANGXING60_WAN_REBOOT_AFTER seconds (default 300), repairs have
# been running that whole time without helping, and the modem does not answer a bare "AT", reboot
# once. The marker lives in /var/run, which is tmpfs (/var -> tmp on this rootfs), so it is per boot
# by construction: one reboot may be worth it, a reboot loop is not.
REBOOT_MARK=/var/run/changxing60-wan-rebooted

# ---------------------------------------------------------------------------
# Subsystem-level recovery: restart the CP (modem firmware), not the phone.
#
# The wedge is CP-side (docs/changxing60/sipa-wedge.md): the AP's 2 s delegator timeout unlocks the
# AP's resource manager, but the CP never answers again, so re-attaching cannot bring the
# bearer back and neither can sim_reset -- its AT commands go to the very port that is dead.
# The only thing that did was a reboot, at ~16 min per cycle, 20-25 times a day.
#
# The modem loader's own stop/start (/dev/modem ioctl; unlike MODEM_ASSERT_CMD it has no
# comm gate) is the vendor-supported way back. Dry run on a healthy boot (sipa-wedge.md
# §6.6): the AP holds the CP down, RM releases every session, and the whole stack rebuilds
# by itself in ~5-10 s with no reboot. CHANGXING60_CP_RESET=0 disables the whole path, so the old
# reboot-only behaviour is one variable away without editing this file.
#
# modem_control (the vendor daemon in the chroot) must be alive, or the PM co-processor cuts
# power mid-experiment -- the same preflight the standalone tools/changxing60-cp-reset.sh runs.
CP_TOOL=/opt/changxing60/bin/modem-ioctl
CP_DEV=${CHANGXING60_MODEM_DEV:-/dev/modem}   # CHANGXING60_MODEM_DEV is a test seam (see tools/mobile-data/test-escalate.sh)
CP_MARK=/var/run/changxing60-wan-cp-reset      # set while a CP restart has been spent on this outage
# The CP's AP-side run flag, out of the modem loader's debugfs (sprd_modem_loader.c:1213). This is the
# only witness that the CP actually moved: `stop` is open-loop -- four regmap pokes and 200 ms of
# msleeps (soc_modem_stop) -- so a rc of 0 means the ioctl was accepted, never that the CP stopped.
# Reading it is what separates "the lever was refused" from "the lever moved and the call stayed dead".
CP_STATE=${CHANGXING60_MODEM_STATE:-/sys/kernel/debug/modem/modem}

cp_state() {
    local s
    # `|| s=` for set -e: a missing debugfs node fails the substitution, and this must not be fatal.
    s=$(sed -n 's/^run_state: \([0-9]*\).*/\1/p' "$CP_STATE" 2>/dev/null) || s=
    [ -n "$s" ] || s=?
    echo "$s"
}

cp_reset() {
    local cp_out cp_rc state0 state1 state2
    [ "${CHANGXING60_CP_RESET:-1}" = 1 ] || return 1
    [ -x "$CP_TOOL" ] || { note "cp-reset refused: $CP_TOOL is not executable"; echo "cp-reset: $CP_TOOL missing" >&2; return 1; }
    [ -c "$CP_DEV" ] || { note "cp-reset refused: $CP_DEV is not a character device"; echo "cp-reset: $CP_DEV missing" >&2; return 1; }
    # [v] keeps the grep from matching this shell's own command line.
    if ! ps w 2>/dev/null | grep -q "[v]endor/bin/modem_control"; then
        note "cp-reset refused: modem_control is not running (the PM may cut power)"
        echo "cp-reset: modem_control is not running, refusing (the PM may cut power)" >&2
        return 1
    fi
    # Both the ioctl's exit status and its one-line report used to go to the volatile ring behind a
    # `|| true`, and that pair is exactly what tells the two failure modes apart: a *refused* stop (the
    # lever never moved, so the wedge surviving it says nothing about the lever) versus a stop that
    # worked and a stack that did not rebuild (the lever works and is not enough). The last wedge --
    # 2026-10-16, bad for ~300 s, reboot at uptime 1597 s -- cannot be attributed at all from the
    # kernel side, and the tempting inference is wrong: `modem run = %d!` is a dev_info
    # (sprd_modem_loader.c:806) while quiet-console pins printk to `4 4 1 4`, so the console capture
    # only ever carries ERR and above -- the *absence* of that line there proves nothing -- and the
    # dmesg ring does not survive the reboot either. Nothing on the box said which of "never called",
    # "refused preflight" or "ioctl failed" it was. Now the ext4 does, and run_state says whether the
    # CP actually moved.
    state0=$(cp_state)
    cp_out=$("$CP_TOOL" stop 2>&1) && cp_rc=0 || cp_rc=$?
    state1=$(cp_state)
    echo "cp-reset: stopping the CP: [$cp_out] rc=$cp_rc state $state0->$state1" >&2
    note "cp-reset: stop rc=$cp_rc run_state $state0->$state1 out=[$cp_out]"
    sleep 3
    cp_out=$("$CP_TOOL" start 2>&1) && cp_rc=0 || cp_rc=$?
    state2=$(cp_state)
    echo "cp-reset: starting the CP: [$cp_out] rc=$cp_rc state $state1->$state2" >&2
    note "cp-reset: start rc=$cp_rc run_state $state1->$state2 out=[$cp_out]"
    # The stack rebuilds on its own; give it ~90 s and watch for the call to come back.
    local i=0
    while [ $i -lt 90 ]; do
        sleep 3
        i=$((i + 3))
        if link_up && probe_ok; then
            # Also worth recording when it *works*: this is the one case where the box healed itself
            # without a reboot, and last time it worked nobody could tell from the ext4 that it had.
            echo "cp-reset: data call back by itself after ${i}s" >&2
            note "cp-reset: the call came back by itself after ${i}s"
            return 0
        fi
    done
    echo "cp-reset: CP restarted but the call did not return within ${i}s" >&2
    note "cp-reset: the call did not return within ${i}s"
    return 1
}

# 0 = the modem answered, 1 = silence, 2 = not asked (and then do not reboot).
at_state() {
    # Never ask while $IFACE still has an address. With the switch off (no /etc/changxing60/at-split) the data
    # call and the AT channel are one port -- up() ends with AT+CGDATA="M-ETHER",1 on nr1 -- so a probe
    # there could push three bytes into a live packet stream. With no address there is no call left to
    # corrupt; at worst the bytes are read as a reply by an attach that is already stuck, and the reboot
    # this feeds discards it anyway. The restriction costs nothing, because the repair above takes the
    # address down before it re-attaches: a wedged call reaches this state through its own repair.
    link_up && return 2
    local dir=
    if [ -p "$DATA_DIR/cmd" ]; then dir=$DATA_DIR
    elif [ -p "$MAIN_DIR/cmd" ]; then dir=$MAIN_DIR
    fi
    # Nobody to ask, and this script must not open the channel itself any more: since init.d/changxing60-at a
    # daemon owns it, and a second reader takes half of every reply away from it. "Not asked" is the
    # honest answer -- the caller vetoes the reboot on it (see maybe_reboot).
    [ -n "$dir" ] || return 2
    # changxing60-at answers with the daemon's own verdict rather than a bare read: status 0 only when the
    # modem produced a final result code, so a channel that is up but silent still reads as silence.
    CHANGXING60_AT_DIR="$dir" "$AT_BIN" -t 3 AT >/dev/null 2>&1 && return 0
    return 1
}

# Uptime at which the call first looked unusable, kept across ticks; 0 while it looks usable.
bad_clock() {
    local now
    [ "${1:-0}" -ne 0 ] && { echo "$1"; return 0; }
    read -r now _ < /proc/uptime 2>/dev/null || now=0
    echo "${now%.*}"
}

# Every escalation below ends in either a CP restart or a reboot, and both of those destroy the
# evidence of what asked for them: /var/run and /tmp are tmpfs, and the logger ring goes with the
# reboot. On 2026-10-16 that cost an hour of reading a ramoops log to work out that this script, and
# not hotspot-watch, had restarted the box. So write it down on the ext4 first -- one line, bounded,
# readable long after the fact and picked up by bootdiag's next dump.
SELFHEAL=/root/selfheal.log
TAG=mobile-data
note() {
    { printf '%s uptime=%s %s: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" \
        "$(cut -d. -f1 /proc/uptime 2>/dev/null)" "$TAG" "$*"; } >> "$SELFHEAL" || true
    tail -n 200 "$SELFHEAL" > "$SELFHEAL.new" 2>/dev/null && mv "$SELFHEAL.new" "$SELFHEAL" 2>/dev/null || true
}

maybe_reboot() {  # $1 = bad_clock value, $2 = uptime of the repair that is (or was) in flight
    local now age st=0 cp_tried=0
    [ "${1:-0}" -ne 0 ] || return 0     # the call looks usable: nothing to escalate
    [ "${2:-0}" -ne 0 ] || return 0     # no repair has run yet: repair before rebooting
    read -r now _ < /proc/uptime 2>/dev/null || return 0
    now=${now%.*}
    age=$((now - $1))
    [ "$age" -ge "${CHANGXING60_WAN_REBOOT_AFTER:-300}" ] || return 0
    # A repair started less than a minute ago may still be attaching. (netifd's own in-flight attach
    # arrives here as $2 = the time that attach began, so this does not mute the wedged-pending case.)
    [ $((now - $2)) -ge 60 ] || return 0
    [ -e "$REBOOT_MARK" ] && return 0   # once per boot

    # Before giving up on this boot, spend the one repair that is stronger than re-attaching:
    # restart the CP. It re-creates the modem stack the wedge lives in, and the dry run showed
    # the call returning by itself in ~5-10 s. Reached only when the call has been unusable for
    # CHANGXING60_WAN_REBOOT_AFTER seconds with repairs not helping, so it can never fire against a
    # working call. Attempted once per outage -- the marker is cleared as soon as a call is
    # healthy again (set_health ok), so a later outage may restart the CP again.
    if [ "${CHANGXING60_CP_RESET:-1}" = 1 ] && [ ! -e "$CP_MARK" ]; then
        cp_tried=1
        touch "$CP_MARK"
        note "call unusable for ${age}s, repairs not helping: restarting the CP"
        echo "call unusable for ${age}s, repairs not helping: restarting the CP" >&2
        cp_reset && return 0            # it worked; watch() sees the call back on the next tick
    elif [ -e "$CP_MARK" ]; then
        cp_tried=1
    fi

    at_state || st=$?
    # 0 = answered, 1 = silence, 2 = not asked. Silence is the reboot's go-ahead. "Not asked" is
    # normally a veto -- never reboot on a guess -- but once a CP restart has been spent and
    # failed there is nothing left to wait for: the call has been bad for CHANGXING60_WAN_REBOOT_AFTER
    # and the one subsystem-level repair is gone, so escalate instead of watching forever.
    if [ "$cp_tried" -eq 1 ] && [ "$st" -eq 2 ]; then
        st=1
    fi
    [ "$st" -eq 1 ] || return 0         # it answered (0), or it must not be asked (2)
    echo "call unusable for ${age}s, repairs not helping and no answer to AT: rebooting" >&2
    note "call unusable for ${age}s, repairs not helping and no answer to AT (at_state=$st, cp_restart_spent=$cp_tried): rebooting"
    touch "$REBOOT_MARK"
    sync
    sleep 1
    # CHANGXING60_REBOOT_CMD is a test seam: it lets the decision be exercised without restarting the box.
    ${CHANGXING60_REBOOT_CMD:-reboot}
}

# The modem firmware occasionally resets itself (modem_control reloads it); it comes back with the radio off and
# no PDP context, which Android's RIL repairs silently. Check the call every 30 s and repair it when it is
# gone -- where "gone" now means either the address is gone (link_up) or the call has stopped carrying
# traffic while keeping the address (probe_ok).
watch() {
    local fails=0 ticks=0 unreach=0 last_try=0 now backoff=0 rx_now tx_now rx_last=0 tx_last=0 bad_since=0
    modem_stack || { echo "no modem stack in this kernel ($(uname -r)), not watching" >&2; exit 0; }
    WAN_PROBES=$(wan_probes)
    while :; do
        sleep "${CHANGXING60_WATCH_INTERVAL:-30}"
        [ -e /run/changxing60-mobile-data-down ] && continue
        [ -c "$DEV" ] || continue
        if [ "${CHANGXING60_NETIFD:-0}" = 1 ] && wan_pending; then
            # netifd is midway through attaching: /dev/stty_nr1 is in use and an `ifup` now would
            # start a second attach that steals this one's AT responses. Both would then fail and
            # retry, each failure spawning another attach, until the port is a queue of dead
            # processes. Wait for netifd to settle before touching the modem.
            fails=0
            # But an attach that never settles is the 2026-10-13 outage's own shape (pending for 20
            # minutes with the port dead), so it still counts as "a repair is in flight" for the
            # last resort -- hence $2 = bad_since, the time this wait began.
            bad_since=$(bad_clock "$bad_since")
            maybe_reboot "$bad_since" "$bad_since"
            continue
        fi
        if link_up; then
            fails=0
            # Traffic since the last tick is proof the call works, and it is free -- no probe, no
            # radio wakeup. This is also what keeps a busy link safe from a false "dead" verdict.
            rx_now=0; tx_now=0
            read -r rx_now _ < "/sys/class/net/$IFACE/statistics/rx_packets" 2>/dev/null || true
            read -r tx_now _ < "/sys/class/net/$IFACE/statistics/tx_packets" 2>/dev/null || true
            if [ "${rx_now:-0}" -gt "${rx_last:-0}" ] || [ "${tx_now:-0}" -gt "${tx_last:-0}" ]; then
                rx_last=$rx_now; tx_last=$tx_now
                unreach=0; backoff=0; bad_since=0
                set_health ok
                continue
            fi
            rx_last=$rx_now; tx_last=$tx_now
            # Idle, so ask the far side. Every third tick (~90 s): often enough to catch a wedged
            # call quickly, rare enough not to keep waking the radio for no reason.
            ticks=$((ticks + 1))
            [ $((ticks % 3)) -eq 0 ] || continue
            if probe_ok; then
                unreach=0; backoff=0; bad_since=0
                set_health ok
                continue
            fi
            set_health dead
            bad_since=$(bad_clock "$bad_since")
            unreach=$((unreach + 1))
            # A probe can be lost on a healthy call; three in a row cannot.
            if [ "$unreach" -lt 3 ]; then
                maybe_reboot "$bad_since" "$last_try"
                continue
            fi
            unreach=0
            echo "mobile data wedged (address present but ${WAN_PROBES%% *} unreachable)" >&2
        else
            # Reachable only with the call already down, so the attach below cannot collide with a live
            # data session; the one stty is kept for the reset path (it is a no-op when already raw, and
            # it waits for the daemon to be gone -- this is the tick that may find the service dead).
            if own_tty; then stty -F "$DEV" raw -echo 2>/dev/null || true; fi
            fails=$((fails + 1))
            bad_since=$(bad_clock "$bad_since")
            if [ "$fails" -lt 2 ]; then
                maybe_reboot "$bad_since" "$last_try"
                continue
            fi
            echo "mobile data lost (modem reset or detached), reconnecting" >&2
        fi
        # At most one repair per 10 minutes. The outage this replaces was built from retrying an
        # attach on a port that was already attached; a tight loop here would rebuild exactly that.
        read -r now _ < /proc/uptime 2>/dev/null || now=0
        now=${now%.*}
        if [ $((now - last_try)) -lt 600 ]; then
            # Rate-limited, so this tick is a chance to ask the last resort. $2 = bad_since when no
            # repair has run yet would read as "a repair began when the call went bad", which is not
            # true -- pass last_try, which is 0 until one really has.
            maybe_reboot "$bad_since" "$last_try"
            continue
        fi
        last_try=$now
        [ -w /sys/class/leds/sc27xx:blue/brightness ] && echo 0 > /sys/class/leds/sc27xx:blue/brightness
        if [ "${CHANGXING60_NETIFD:-0}" = 1 ]; then
            # `ifup` alone is a no-op while netifd still believes the interface is up -- which is
            # precisely the wedged case, so take it down first and let the protocol run again.
            ifdown "${CHANGXING60_WAN:-wan}"
            sleep 2
            ifup "${CHANGXING60_WAN:-wan}"
        else
            ( up ) || echo "reconnect failed, retrying" >&2
        fi
        fails=0
        ticks=0
        backoff=$((backoff + 1))
        if [ "$backoff" -ge 3 ]; then
            # Re-attaching has not helped three times running, so the trouble is deeper than the
            # PDP context: put the radio through the full off/on + PIN wait, which is what Android's
            # RIL does and the only thing short of a reboot known to clear a stuck AT port here.
            backoff=0
            echo "re-attach did not restore the data path 3 times, resetting the radio" >&2
            sim_reset >&2 || true
        fi
    done
}

# netifd reports "pending": true while a protocol handler is running, i.e. while an attach owns the AT port.
wan_pending() {
    ubus -S call network.interface."${CHANGXING60_WAN:-wan}" status 2>/dev/null | grep -q '"pending": *true'
}

status() {
    # some tty flags are not supported by the modem tty; only while this script owns it (see own_tty)
    if own_tty; then stty -F "$DEV" raw -echo 2>/dev/null || true; fi
    at 'AT+COPS?'; at 'AT+CSQ'; at 'AT+CEREG?'; at 'AT+CGACT?'
    ip -br addr show "$IFACE"
}

case "${1:-status}" in
    up) up_locked "${2:-}" ;;
    down) down ;;
    status) status ;;
    sim-reset) sim_reset ;;
    cp-reset) cp_reset ;;          # subsystem-level recovery: restart the CP (see cp_reset above)
    watch) watch ;;
    *) echo "usage: $0 up [APN] | down | status | sim-reset | cp-reset | watch" >&2; exit 2 ;;
esac
