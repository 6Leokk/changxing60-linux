#!/bin/sh
# Watch the bearer's public SLAAC prefix and keep it routed to the hotspot bridge.
#
# The carrier hands out one /64 by RA on sipa_eth0 -- it never fills +CGCONTRDP's IPv6 address
# (that field carries the interface identifier only, with the prefix zeroed), so the RA is the only
# source of the prefix -- and odhcpd relays that RA to Wi-Fi clients, which SLAAC their own public
# addresses out of it. Replies to those addresses (NAT66 DNAT on the way back, or any traffic inside
# the prefix) must be delivered on br-wifi -- but no on-link route for the prefix exists there:
# changxing60cell.sh flushes the bearer's v6 routes on every setup, so a lookup for a client address falls
# through to the default route and the reply leaves via the modem towards the carrier gateway, where
# it disappears. Measured upstream: every connection from a client address without a pinned /128
# timed out (stable SLAAC addresses never made it into the neighbour table, so only the privacy
# addresses were ever pinned), and Android clients reacted by suppressing AAAA queries for the whole
# network -- "DNS resolves nothing over IPv6, IPv6 looks dead end to end" -- until the next reconnect
# forgot the verdict.
#
# The /64 on br-wifi is the mechanism: NDP there resolves each client on demand, with no race for
# addresses that never showed up in the neighbour table. The prefix is tracked so a carrier renumber
# replaces the route instead of stacking a stale one. Its metric is below the RA's own route for the
# same /64 on sipa_eth0 (metric 256, re-created by the carrier's RA after every accept_ra cycle): the
# lower metric wins, so replies go to the LAN, not back out the bearer. Nothing legitimate in the /64
# lives behind sipa_eth0, and the router's own address there is in the local table, which a main-table
# route cannot override.
#
# Nothing is learnt from the LAN. The fork this was ported from also pinned a /128 to the LAN for
# every global address in the bridge's neighbour table, "a small latency optimisation" -- but any LAN
# client can put any address there with a spoofed neighbour advertisement, so that pinned another
# client's address, the router's own, or an internet host's (a DNS server, say) to the LAN: a route
# hijack. The pins are left out; the /64 route does the work. Every value that reaches `ip` is checked
# to be a plain IPv6 address inside the bearer's /64.
#
# Deviation from upstream (dikeckaan/mu300-linux, itself ported from kanoqwq/clean-tf-7.2 cd4fb28):
# they route the /64 to br-lan, because upstream's single bridge carries both the USB gadget and the
# AP. This port has the two split (see net-split), and the management link deliberately hands the PC
# on the far end of the cable no router and no DNS -- a second default route on that link outranked
# the PC's real uplink on Windows (measured 2026-10-13). A public v6 prefix on br-lan is the same
# mistake in the other family, so the /64 goes to br-wifi only; br-lan keeps ra/dhcpv6 disabled.
#
# ndp-learn --prefix: print the bearer's /64 (nothing when it has none) and exit.
# ndp-learn --once: one round (no router solicitation, no sleep) and exit.

# fixed-width hex, one line per address: address, ifindex, prefix length, scope, flags, name
IF_INET6=${CHANGXING60_IF_INET6:-/proc/net/if_inet6}
BEARER_IF=${CHANGXING60_NDP_BEARER_IF:-sipa_eth0}
LAN_IF=${CHANGXING60_NDP_LAN_IF:-br-wifi}

# The bearer's global /64, from $IF_INET6 (the kernel's own address, never the LAN's). That file uses
# fixed-width hex, so this also handles prefixes whose first four hextets are compressed by
# `ip -6 addr`. Global unicast only (2000::/3): never link-local, multicast or anything else a
# misconfigured scope could let through.
bearer_prefix() {
    awk -v iface="$BEARER_IF" '$6==iface && $4=="00" && $1 ~ /^[23][0-9a-f]{31}$/ {
        for (i=1; i<=4; i++) {
            h=substr($1,(i-1)*4+1,4); sub(/^0+/,"",h);
            if (h=="") h="0";
            printf "%s%s", (i>1?":":""), h;
        }
        print "::/64"; exit
    }' "$IF_INET6" 2>/dev/null
}

# in_prefix ADDR STEM: ADDR is a plain IPv6 address (hex digits and colons only, so nothing ip could
# read as an option or a second argument) that starts with STEM: (inside the /64), and is not the
# subnet-router anycast STEM::.
in_prefix() {
    case $1 in
        ''|-*|*[!0-9a-f:]*) return 1 ;;
        "$2::") return 1 ;;
        "$2:"*) return 0 ;;
    esac
    return 1
}

# Below the RA route's 256 (see above). Before upstream's review this was 1024, which lost to the RA
# route; a route an earlier run installed at that metric is removed, so it never lingers beside this.
LAN_METRIC=128
OLD_METRIC=1024

# lan_route PREFIX: route PREFIX to the bridge. replace is idempotent, so every round can run it:
# one route, never two.
lan_route() {
    ip -6 route replace "$1" dev "$LAN_IF" metric $LAN_METRIC 2>/dev/null
    ip -6 route del "$1" dev "$LAN_IF" metric $OLD_METRIC 2>/dev/null
}

drop_old_prefix() {
    [ -n "$1" ] || return 0
    ip -6 route del "$1" dev "$LAN_IF" metric $LAN_METRIC 2>/dev/null
    ip -6 route del "$1" dev "$LAN_IF" metric $OLD_METRIC 2>/dev/null
}

last_prefix=
learn_once() {
    prefix=$(bearer_prefix)
    if [ -z "$prefix" ] && [ -n "$last_prefix" ]; then
        drop_old_prefix "$last_prefix"
        last_prefix=
    fi
    [ -n "$prefix" ] || return 0
    if [ "$prefix" != "$last_prefix" ]; then
        drop_old_prefix "$last_prefix"
        last_prefix=$prefix
        logger -t ndp-learn "LAN prefix route: $prefix dev $LAN_IF metric $LAN_METRIC"
    fi
    # every round, so a route someone or something removed comes back within one round
    lan_route "$prefix"
    # odhcpd's NDP relay can learn a downstream client's /128 on the WAN side. The relay config leaves
    # NDP relay off, but a hand-made config can turn it back on, and that more-specific route overrides
    # the LAN /64 and blackholes NAT66 replies. Remove only host routes inside the shared prefix; the
    # LAN /64 resolves the client by NDP even before it appears in the neighbour table.
    stem=${prefix%::/64}
    for r in $(ip -6 route show dev "$BEARER_IF" 2>/dev/null | awk '$1 !~ /\// {print $1}'); do
        in_prefix "$r" "$stem" && ip -6 route del "$r/128" dev "$BEARER_IF" 2>/dev/null
    done
    return 0
}

case ${1:-} in
    --prefix) bearer_prefix; exit 0 ;;
    --once) learn_once; exit 0 ;;
esac

while :; do
    learn_once
    # Self-heal the bearer's own public address. The carrier sends no unsolicited router
    # advertisement at all -- it answers a router solicitation, and nothing else on this device ever
    # sends one: changxing60cell.sh does it once per setup, which is enough on a bearer that came up
    # normally and not enough when the setup raced the modem or a redial flushed the address.
    #
    # The recipe is the one measured on the wire (5.4.254, China Mobile, 2026-10-13), and it is not
    # upstream's: a bare accept_ra 0->2 flip sends nothing whatsoever, while re-enabling IPv6 with
    # accept_ra already 2 sends an RS once DAD on the rebuilt link-local finishes and the answer is
    # back in under 100 ms. accept_ra therefore goes to 2 first and is left alone afterwards --
    # writing it again after the restart cancels the pending solicitation.
    #
    # This runs only while the bearer has no global address, which after a normal setup is never:
    # the advertisement's lifetimes are infinite, so the address does not expire and no renewal
    # traffic is needed. It is here for the redial case and for a boot that missed the RA.
    if ! ip -6 addr show "$BEARER_IF" 2>/dev/null | grep -q 'scope global'; then
        echo 2 > /proc/sys/net/ipv6/conf/$BEARER_IF/accept_ra 2>/dev/null
        echo 1 > /proc/sys/net/ipv6/conf/$BEARER_IF/disable_ipv6 2>/dev/null
        sleep 1
        echo 0 > /proc/sys/net/ipv6/conf/$BEARER_IF/disable_ipv6 2>/dev/null
        sleep 2
        prefix=$(bearer_prefix)
        [ -n "$prefix" ] && logger -t ndp-learn "bearer re-solicited, prefix $prefix"
    fi
    sleep 10
done
