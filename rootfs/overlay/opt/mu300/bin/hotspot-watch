#!/bin/sh
# Keep the hotspot on air.
#
# The failure this exists for is deceptive: the AP looks healthy from the host while being dead
# for the client. wlan0 stays UP, the bridge keeps the port, and hostapd keeps answering
# `ubus call hostapd.wlan0 get_status` with "ENABLED" and the pinned BSSID -- all three of those
# were measured on this device *while the radio was powered off*. So none of them can be the test.
# Neither can the obvious counters: /sys/class/net/wlan0/statistics/tx_packets reads 0 on this
# driver even after the AP has carried a gigabyte, and `iw dev wlan0 station dump` returns nothing
# even with a client associated. And a client-based probe cannot work either -- by the time the AP
# is dead the client is gone, so there is nobody to ping.
#
# What works is asking the firmware. Writing to the WCN device's atcmd attribute reaches
# wcn_send_atcmd() (sysfs.c:63), which refuses with -EIO unless the firmware is downloaded and the
# bus is usable ("can not send atcmd before download flag is true"):
#
#     echo AT > /sys/devices/virtual/misc/wcn/devices/atcmd      # rc 0 alive, rc 1 dead
#
# Measured both ways on 2026-10-13: rc=0 with the AP up, and rc=1 with write error "I/O error"
# after the radio was powered off. AT itself is a no-op query; the return code is the signal, and
# when the radio is down the write never reaches the firmware at all.
#
# The recovery is `wifi down; wifi up` -- not a reboot. That re-downloads the firmware (visible as
# CMD_DOWNLOAD_INI and a fresh WCN_VER line) and the AP is ENABLED with the same BSSID about 6 s
# later, client reassociating and passing traffic. Why the radio is down in the first place is
# mu300-hw's doing: it sets reset_dump=reset so that a firmware assert powers the radio off and
# lets the WLAN driver's own reset_work clear the wedge, instead of the stock "dump" behaviour of
# reading out memory and leaving cp_asserted = 1 forever. That chain ends with the interface
# closed (sc2355_reset_self closes the netdev and returns early in AP mode, tx.c:1864), and
# re-opening it is this script's job. See mu300-hw for the assert-policy half.
INTERVAL=${MU300_HOTSPOT_INTERVAL:-30}
MAX_REPAIR=${MU300_HOTSPOT_MAX_REPAIR:-6}
ATCMD=/sys/devices/virtual/misc/wcn/devices/atcmd
RESETDUMP=/sys/devices/virtual/misc/wcn/devices/reset_dump
REPAIRS=/tmp/hotspot-watch.repairs
REBOOT_MARK=/tmp/hotspot-watch.rebooted

# Empty when the firmware is alive and answering; a reason string when it is not.
radio_down() {
	[ -e "$ATCMD" ] || { echo "no $ATCMD"; return; }
	echo AT > "$ATCMD" 2>/dev/null || { echo "atcmd probe failed (firmware not downloaded)"; return; }
	# Independent of the probe: catches an AP that never got as far as starting its BSS.
	st=$(ubus call hostapd.wlan0 get_status 2>/dev/null)
	if [ -z "$st" ]; then
		echo "hostapd has no status"
		return
	fi
	[ "$(echo "$st" | sed -n 's/.*"status": "\([^"]*\)".*/\1/p')" = "ENABLED" ] ||
		{ echo "hostapd not ENABLED"; return; }
	case "$(echo "$st" | sed -n 's/.*"bssid": "\([^"]*\)".*/\1/p')" in
	""|00:00:00:00:00:00) echo "bssid is zero" ;;
	esac
}

repair() {
	n=$(cat "$REPAIRS" 2>/dev/null || echo 0)
	if [ "$n" -ge "$MAX_REPAIR" ]; then
		logger -t hotspot-watch "$1, but already repaired $n times; not retrying"
		return
	fi
	logger -t hotspot-watch "$1 -- restarting wifi (repair $((n + 1))/$MAX_REPAIR)"
	echo $((n + 1)) > "$REPAIRS"
	wifi down
	sleep 2
	wifi up
	sleep 15
	why=$(radio_down)
	if [ -z "$why" ]; then
		logger -t hotspot-watch "radio back"
	elif [ "$n" -ge $((MAX_REPAIR - 1)) ]; then
		# Last resort. Measured 2026-10-13: repeated chip power-offs can leave the SDIO bus in
		# carddump (dmesg "carddump flag set[1]", "disable rx int for dump", "CMD53 write failed
		# with code -110"), and in that state no firmware download is possible and restarting wifi
		# cannot help -- only a reboot clears it. Restarting the box is better than leaving the
		# user with an AP that associates and never forwards.
		if [ -e "$REBOOT_MARK" ]; then
			logger -t hotspot-watch "radio still down ($why) and already rebooted once; leaving it"
		else
			logger -t hotspot-watch "radio still down ($why) after $MAX_REPAIR repairs; rebooting"
			touch "$REBOOT_MARK"
			sync
			sleep 1
			reboot
		fi
	else
		logger -t hotspot-watch "radio still down ($why)"
	fi
}

# mu300-hw writes this at boot; re-assert it in case the write there lost a race with the device.
[ -w "$RESETDUMP" ] && [ "$(cat "$RESETDUMP" 2>/dev/null)" != "reset" ] &&
	echo reset > "$RESETDUMP"
logger -t hotspot-watch "watching (interval ${INTERVAL}s, reset_dump=$(cat "$RESETDUMP" 2>/dev/null))"

# mu300-post's wififix is still running its own startup repair for the first ~50 s; do not race it
# into thinking the AP is broken.
sleep "${MU300_HOTSPOT_GRACE:-50}"

while :; do
	sleep "$INTERVAL"
	why=$(radio_down)
	[ -n "$why" ] && repair "$why"
done
