#!/bin/sh /etc/rc.common
# mu300-vpn: the sing-box VLESS tunnel (see /opt/mu300/bin/mu300-vpn) as a procd service.
# The container's /etc/mu300/vpn.conf holds the settings; ENABLE=1 arms the tunnel.
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /opt/mu300/bin/mu300-vpn run
    procd_set_param respawn 3600 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # the kill switch deliberately survives a crash- stop only removes it on an explicit request,
    # same contract as the upstream Ubuntu service
    /opt/mu300/bin/mu300-vpn off >/dev/null 2>&1 || true
}
